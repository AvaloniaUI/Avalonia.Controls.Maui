<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Enable Resizetizer for Avalonia.Controls.Maui applications -->
  <PropertyGroup>
    <_ResizetizerIsAvaloniaApp>True</_ResizetizerIsAvaloniaApp>
    <!-- Use 'wpf' platform type for Resizetizer so it generates images -->
    <ResizetizerPlatformType>wpf</ResizetizerPlatformType>
    <_AvMauiTargetPlatformId>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_AvMauiTargetPlatformId>
  </PropertyGroup>

  <PropertyGroup>
    <_ResizetizerIsCompatibleApp>True</_ResizetizerIsCompatibleApp>

    <ResizetizeDependsOnTargets>
      $(ResizetizeDependsOnTargets);
      ResizetizeCollectItems;
      _RemoveUnsupportedMauiItems;
      ProcessMauiSplashScreens;
      _ReadResizetizeImagesOutputs;
    </ResizetizeDependsOnTargets>

    <ProcessMauiFontsDependsOnTargets>
      $(ProcessMauiFontsDependsOnTargets);
      ResizetizeCollectItems;
      ProcessMauiAssets;
      ProcessMauiSplashScreens;
    </ProcessMauiFontsDependsOnTargets>

    <ResizetizeAfterTargets>
      $(ResizetizeAfterTargets);
      ResizetizeCollectItems;
    </ResizetizeAfterTargets>

    <ResizetizeBeforeTargets>
      $(ResizetizeBeforeTargets);
      GenerateAvaloniaResources;
    </ResizetizeBeforeTargets>

    <ProcessMauiFontsBeforeTargets>
      $(ProcessMauiFontsBeforeTargets);
      GenerateAvaloniaResources;
    </ProcessMauiFontsBeforeTargets>
  </PropertyGroup>

  <Target Name="_RemoveUnsupportedMauiItems"
          Condition="'$(_AvMauiTargetPlatformId)' == 'browser'">
    <ItemGroup>
      <MauiIcon Remove="@(MauiIcon)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(MauiImage)">
      <Output TaskParameter="Filtered" ItemName="_UniqueMauiImages" />
    </RemoveDuplicates>
    <ItemGroup>
      <MauiImage Remove="@(MauiImage)" />
      <MauiImage Include="@(_UniqueMauiImages)" />
    </ItemGroup>
  </Target>

  <!-- SkiaSharp 4.151+ and HarfBuzzSharp 14.2.1.102+ ship Emscripten 5.0.6 static libraries for
       net11.0+ and select them from their own buildTransitive targets. Avalonia.Browser.targets
       (12.1.x) predates that and still adds the Emscripten 3.1.56 archives for every TFM >= net9.0,
       so on net11.0 both sets would be handed to the linker. Drop the stale 3.1.56 archives so only
       the ones SkiaSharp/HarfBuzzSharp picked for this TFM are linked. -->
  <Target Name="_AvMauiRemoveLegacyEmscriptenNativeRefs"
          BeforeTargets="_PrepareForBrowserWasmBuildNative;_CoreCLRPrepareForNativeBuild"
          Condition="'$(_AvMauiTargetPlatformId)' == 'browser' And '$(TargetFrameworkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '11.0'))">
    <ItemGroup>
      <_AvMauiLegacyNativeRef Include="@(NativeFileReference)"
          Condition="$([System.String]::Copy('%(FullPath)').Replace('\', '/').Contains('/3.1.56/')) And ($([System.String]::Copy('%(FullPath)').Contains('libSkiaSharp.a')) Or $([System.String]::Copy('%(FullPath)').Contains('libHarfBuzzSharp.a')))" />
      <NativeFileReference Remove="@(_AvMauiLegacyNativeRef)" />
    </ItemGroup>
    <Message Importance="high"
             Text="Avalonia.Controls.Maui: removed Emscripten 3.1.56 native references superseded by the net11.0 SkiaSharp/HarfBuzzSharp libraries: @(_AvMauiLegacyNativeRef)"
             Condition="'@(_AvMauiLegacyNativeRef)' != ''" />
  </Target>

  <Target Name="ConvertMauiImagesToAvaloniaResources"
          BeforeTargets="AddAvaloniaResources"
          DependsOnTargets="ResizetizeImages;_ReadResizetizeImagesOutputs">

    <PropertyGroup>
      <_AvMauiPlatformId>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_AvMauiPlatformId>
    </PropertyGroup>

    <!-- Collect resizetizer images based on platform output structure, and name each one as the
         Avalonia image service looks it up: name.png at 1x, name@2x.png and name@3x.png for the
         display scale, and name@4x.png for desktop.
         On Android, drawable-mdpi is 1x, drawable-xhdpi 2x and drawable-xxhdpi 3x.
         On iOS/macCatalyst, images are flat with @2x/@3x suffixes already.
         On Windows, images have .scale-NNN suffixes: scale-100 is 1x and scale-200 is 2x.
         On net11.0 (wpf mode), images are flat in the intermediate dir. Resizetizer renders a resized
         image once, at 4x its base size, and copies other images unchanged.
         App icons (mipmap-* on Android, Assets.xcassets on iOS) are in subdirs and excluded
         by the non-recursive glob. -->
    <PropertyGroup>
      <_AvMauiIsApple Condition="'$(_AvMauiPlatformId)' == 'ios' Or '$(_AvMauiPlatformId)' == 'maccatalyst'">true</_AvMauiIsApple>
      <_AvMauiIsWindows Condition="$(_AvMauiPlatformId.Contains('windows'))">true</_AvMauiIsWindows>
      <_AvMauiIsDesktop Condition="'$(_AvMauiPlatformId)' != 'android' And '$(_AvMauiIsApple)' != 'true' And '$(_AvMauiIsWindows)' != 'true'">true</_AvMauiIsDesktop>
    </PropertyGroup>

    <!-- Collect each platform's outputs into an item type of its own first: an unqualified
         %(Filename) in new item metadata would batch over the items already in the list -->
    <ItemGroup Condition="Exists('$(_MauiIntermediateImages)')">
      <!-- Clear any stale items from prior incremental builds or resizetizer output tracking -->
      <_ResizetizerCollectedImages Remove="@(_ResizetizerCollectedImages)" />

      <_AvMauiImage1x Condition="'$(_AvMauiPlatformId)' == 'android'"
          Include="$(_MauiIntermediateImages)drawable-mdpi\*"
          Exclude="$(_MauiIntermediateImages)drawable-mdpi\*.xml;$(_MauiIntermediateImages)drawable-mdpi\*.json" />
      <_AvMauiImage2x Condition="'$(_AvMauiPlatformId)' == 'android'"
          Include="$(_MauiIntermediateImages)drawable-xhdpi\*"
          Exclude="$(_MauiIntermediateImages)drawable-xhdpi\*.xml;$(_MauiIntermediateImages)drawable-xhdpi\*.json" />
      <_AvMauiImage3x Condition="'$(_AvMauiPlatformId)' == 'android'"
          Include="$(_MauiIntermediateImages)drawable-xxhdpi\*"
          Exclude="$(_MauiIntermediateImages)drawable-xxhdpi\*.xml;$(_MauiIntermediateImages)drawable-xxhdpi\*.json" />

      <!-- iOS/macCatalyst: flat files whose names already carry @2x/@3x (non-recursive excludes xcassets subdirs) -->
      <_AvMauiImage1x Condition="'$(_AvMauiIsApple)' == 'true'"
          Include="$(_MauiIntermediateImages)*"
          Exclude="$(_MauiIntermediateImages)*.xml;$(_MauiIntermediateImages)*.json" />

      <!-- Windows: .scale-NNN suffixes, stripped below -->
      <_AvMauiWindowsImage1x Condition="'$(_AvMauiIsWindows)' == 'true'" Include="$(_MauiIntermediateImages)*.scale-100.*" />
      <_AvMauiWindowsImage2x Condition="'$(_AvMauiIsWindows)' == 'true'" Include="$(_MauiIntermediateImages)*.scale-200.*" />

      <!-- Default/WPF (net11.0, net11.0-browser, etc.): flat files directly in intermediate dir -->
      <_AvMauiDesktopImage Condition="'$(_AvMauiIsDesktop)' == 'true'"
          Include="$(_MauiIntermediateImages)*"
          Exclude="$(_MauiIntermediateImages)*.xml;$(_MauiIntermediateImages)*.json" />

      <!-- Resizetizer resizes an image with Resize="true", a BaseSize, or a vector source -->
      <_AvMauiResizedImage Include="@(MauiImage)"
          Condition="'%(MauiImage.Resize)' == 'true' Or ('%(MauiImage.Resize)' == '' And ('%(MauiImage.BaseSize)' != '' Or '%(MauiImage.Extension)' == '.svg'))" />
      <_AvMauiDesktopCopiedImage Include="@(_AvMauiDesktopImage)" />
      <_AvMauiDesktopCopiedImage Remove="@(_AvMauiResizedImage)" MatchOnMetadata="Filename" />
      <_AvMauiImage1x Include="@(_AvMauiDesktopCopiedImage)" />
      <_AvMauiImage4x Include="@(_AvMauiDesktopImage)" Exclude="@(_AvMauiDesktopCopiedImage)" />

      <_ResizetizerCollectedImages Include="@(_AvMauiImage1x)">
        <_AvMauiImageName>%(_AvMauiImage1x.Filename)%(_AvMauiImage1x.Extension)</_AvMauiImageName>
      </_ResizetizerCollectedImages>
      <_ResizetizerCollectedImages Include="@(_AvMauiImage2x)">
        <_AvMauiImageName>%(_AvMauiImage2x.Filename)@2x%(_AvMauiImage2x.Extension)</_AvMauiImageName>
      </_ResizetizerCollectedImages>
      <_ResizetizerCollectedImages Include="@(_AvMauiImage3x)">
        <_AvMauiImageName>%(_AvMauiImage3x.Filename)@3x%(_AvMauiImage3x.Extension)</_AvMauiImageName>
      </_ResizetizerCollectedImages>
      <!-- Resizetizer renders a resized desktop image once, at 4x its base size -->
      <_ResizetizerCollectedImages Include="@(_AvMauiImage4x)">
        <_AvMauiImageName>%(_AvMauiImage4x.Filename)@4x%(_AvMauiImage4x.Extension)</_AvMauiImageName>
      </_ResizetizerCollectedImages>
      <_ResizetizerCollectedImages Include="@(_AvMauiWindowsImage1x)">
        <_AvMauiImageName>$([System.IO.Path]::GetFileNameWithoutExtension('%(_AvMauiWindowsImage1x.Filename)'))%(_AvMauiWindowsImage1x.Extension)</_AvMauiImageName>
      </_ResizetizerCollectedImages>
      <_ResizetizerCollectedImages Include="@(_AvMauiWindowsImage2x)">
        <_AvMauiImageName>$([System.IO.Path]::GetFileNameWithoutExtension('%(_AvMauiWindowsImage2x.Filename)'))@2x%(_AvMauiWindowsImage2x.Extension)</_AvMauiImageName>
      </_ResizetizerCollectedImages>

      <!-- Remove any xcassets/platform artifacts that may have been added by the resizetizer's output tracking -->
      <_ResizetizerCollectedImages Remove="@(_ResizetizerCollectedImages)"
          Condition="$([System.String]::new('%(Identity)').Contains('Assets.xcassets'))" />
      <_ResizetizerCollectedImages Remove="@(_ResizetizerCollectedImages)"
          Condition="'%(Extension)' == '.xml' Or '%(Extension)' == '.json'" />
    </ItemGroup>

    <Message Text="Resizetizer intermediate path: $(_MauiIntermediateImages)" Importance="high" />
    <Message Text="Collected MAUI Resizetizer images: @(_ResizetizerCollectedImages)" Importance="high" Condition="'@(_ResizetizerCollectedImages)' != ''" />
    <Message Text="No Resizetizer images found" Importance="high" Condition="'@(_ResizetizerCollectedImages)' == ''" />

    <ItemGroup>
      <AvaloniaResource Include="@(_ResizetizerCollectedImages)" Condition="'@(_ResizetizerCollectedImages)' != ''">
        <Link>Images/%(_ResizetizerCollectedImages._AvMauiImageName)</Link>
      </AvaloniaResource>
    </ItemGroup>

    <Message Text="Converted MAUI Resizetizer images to Avalonia resources: @(_ResizetizerCollectedImages)" Importance="high" Condition="'@(_ResizetizerCollectedImages)' != ''" />
  </Target>

  <Target Name="ConvertMauiFontsToAvaloniaResources"
          BeforeTargets="AddAvaloniaResources"
          Condition="'@(MauiFont)' != ''">

    <ItemGroup>
      <!-- Embed fonts as AvaloniaResource so they can be accessed via avares:// URI -->
      <AvaloniaResource Include="@(MauiFont)">
        <Link>Assets/Fonts/%(Filename)%(Extension)</Link>
      </AvaloniaResource>
    </ItemGroup>

    <Message Text="Converted MAUI fonts to Avalonia resources: @(MauiFont)" Importance="high" />
  </Target>

  <Target Name="ConvertMauiAssetsToAvaloniaResources"
          BeforeTargets="AddAvaloniaResources"
          Condition="'@(MauiAsset)' != ''">
    <ItemGroup>
      <AvaloniaResource Include="@(MauiAsset)">
        <Link>%(MauiAsset.LogicalName)</Link>
      </AvaloniaResource>
    </ItemGroup>
    <Message Text="Converted MAUI assets to Avalonia resources: @(MauiAsset)" Importance="high" />
  </Target>

  <!-- Ensure Avalonia resources are registered as EmbeddedResource before PrepareResources
       runs SplitResourcesByCulture. Without this, NuGet-consumer builds process EmbeddedResource
       items before AddAvaloniaResources has added the Avalonia blob, so it never reaches Csc. -->
  <PropertyGroup>
    <PrepareResourcesDependsOn>
      ConvertMauiImagesToAvaloniaResources;
      AddAvaloniaResources;
      $(PrepareResourcesDependsOn)
    </PrepareResourcesDependsOn>
  </PropertyGroup>

  <PropertyGroup>
    <EnableAvaloniaXamlCompilation Condition="'$(EnableAvaloniaXamlCompilation)' == ''">true</EnableAvaloniaXamlCompilation>
  </PropertyGroup>
</Project>
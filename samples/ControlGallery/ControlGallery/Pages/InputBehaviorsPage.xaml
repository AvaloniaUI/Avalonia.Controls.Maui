<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ControlGallery.Pages.InputBehaviorsPage"
             Title="Input Behaviors">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Formats, limits and reacts to text input with toolkit behaviors." />

            <!-- Masked Input -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Masked Input" />
                <Label StyleClass="h3"
                       Text="MaskedBehavior formats the text as it is typed. Each X in the mask is replaced by a typed character." />
                <Entry Placeholder="(555) 123-4567"
                       Keyboard="Telephone">
                    <Entry.Behaviors>
                        <toolkit:MaskedBehavior Mask="(XXX) XXX-XXXX"/>
                    </Entry.Behaviors>
                </Entry>
                <Entry Placeholder="1234 5678 9012 3456"
                       Keyboard="Numeric">
                    <Entry.Behaviors>
                        <toolkit:MaskedBehavior Mask="XXXX XXXX XXXX XXXX"/>
                    </Entry.Behaviors>
                </Entry>
            </VerticalStackLayout>

            <!-- Max Length Reached -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Max Length Reached" />
                <Label StyleClass="h3"
                       Text="MaxLengthReachedBehavior runs a command when the text reaches the MaxLength of the entry." />
                <Entry Placeholder="Type 5 characters"
                       MaxLength="5">
                    <Entry.Behaviors>
                        <toolkit:MaxLengthReachedBehavior x:Name="MaxLengthBehavior"/>
                    </Entry.Behaviors>
                </Entry>
                <Label x:Name="MaxLengthLabel"
                       Text="Max length reached: (not yet)"/>
            </VerticalStackLayout>

            <!-- User Stopped Typing -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="User Stopped Typing" />
                <Label StyleClass="h3"
                       Text="UserStoppedTypingBehavior runs a command after typing pauses for a short time, for example to start a search." />
                <Entry Placeholder="Search">
                    <Entry.Behaviors>
                        <toolkit:UserStoppedTypingBehavior x:Name="StoppedTypingBehavior"
                                                           StoppedTypingTimeThreshold="700"
                                                           MinimumLengthThreshold="2"/>
                    </Entry.Behaviors>
                </Entry>
                <Label x:Name="StoppedTypingLabel"
                       Text="Search for: (nothing yet)"/>
            </VerticalStackLayout>

            <!-- Focus the Next Entry -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Focus the Next Entry" />
                <Label StyleClass="h3"
                       Text="SetFocusOnEntryCompletedBehavior moves the focus to the next entry when Enter is pressed." />
                <Entry x:Name="FirstNameEntry"
                       Placeholder="First name"
                       ReturnType="Next"
                       toolkit:SetFocusOnEntryCompletedBehavior.NextElement="{x:Reference LastNameEntry}"/>
                <Entry x:Name="LastNameEntry"
                       Placeholder="Last name"
                       ReturnType="Next"
                       toolkit:SetFocusOnEntryCompletedBehavior.NextElement="{x:Reference CityEntry}"/>
                <Entry x:Name="CityEntry"
                       Placeholder="City"
                       ReturnType="Done"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

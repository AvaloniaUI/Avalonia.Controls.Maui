<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.EllipsePage"
             Title="Ellipse">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Draws an ellipse or a circle." />

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Solid Fill" />
                <Ellipse WidthRequest="180"
                         HeightRequest="120"
                         Fill="#0FA3B1"
                         Stroke="#0B6172"
                         StrokeThickness="3" />
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Gradient Fill" />
                <Ellipse WidthRequest="200"
                         HeightRequest="120"
                         StrokeThickness="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5">
                            <GradientStop Color="#FFE36D"
                                          Offset="0" />
                            <GradientStop Color="#FF7959"
                                          Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Outlined" />
                <Ellipse WidthRequest="200"
                         HeightRequest="70"
                         Fill="Transparent"
                         Stroke="#8B5CF6"
                         StrokeThickness="5" />
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             x:Class="ControlGallery.Pages.TabbedPage"
             x:DataType="pages:TabbedPage"
             Title="TabbedPage">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Opens TabbedPage samples with different tabs, icons and bar colors."/>

            <!-- Basic TabbedPage -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic TabbedPage"/>
                <Label StyleClass="h3"
                       Text="A simple TabbedPage with three tabs (Children collection)."/>
                <Button Text="Open Basic TabbedPage"
                        Clicked="OnOpenBasicTabbedPage"/>
            </VerticalStackLayout>

            <!-- ItemsSource / DataTemplate (FIRST - Most Important) -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="ItemsSource with DataTemplate"/>
                <Label StyleClass="h3"
                       Text="TabbedPage populated from a data collection using ItemsSource and ItemTemplate."/>
                <Button Text="ItemsSource Demo"
                        Clicked="OnOpenItemsSourceTabbedPage"/>
            </VerticalStackLayout>

            <!-- SelectedItem (from MultiPage<T>) -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="SelectedItem Binding"/>
                <Label StyleClass="h3"
                       Text="TabbedPage with SelectedItem set programmatically (inherited from MultiPage)."/>
                <Button Text="SelectedItem Demo"
                        Clicked="OnOpenSelectedItemTabbedPage"/>
            </VerticalStackLayout>

            <!-- Tab Icons -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Tab Icons"/>
                <Label StyleClass="h3"
                       Text="TabbedPage with icons on tabs using Page.IconImageSource."/>
                <Button Text="Tabs with Icons"
                        Clicked="OnOpenIconsTabbedPage"/>
                <Button Text="Dynamic Tab Icons"
                        Clicked="OnOpenDynamicIconsTabbedPage"/>
            </VerticalStackLayout>

            <!-- Bar Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Bar Background Color"/>
                <Label StyleClass="h3"
                       Text="TabbedPage with custom BarBackgroundColor."/>
                <Button Text="Blue Bar Background"
                        Clicked="OnOpenBlueBarTabbedPage"/>
                <Button Text="Dark Bar Background"
                        Clicked="OnOpenDarkBarTabbedPage"/>
            </VerticalStackLayout>

            <!-- Bar Text Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Bar Text Color"/>
                <Label StyleClass="h3"
                       Text="TabbedPage with custom BarTextColor."/>
                <Button Text="White Text on Dark Bar"
                        Clicked="OnOpenWhiteTextTabbedPage"/>
                <Button Text="Red Text on Light Bar"
                        Clicked="OnOpenRedTextTabbedPage"/>
            </VerticalStackLayout>

            <!-- Selected/Unselected Tab Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Tab Selection Colors"/>
                <Label StyleClass="h3"
                       Text="Custom colors for selected and unselected tabs."/>
                <Button Text="Custom Tab Colors"
                        Clicked="OnOpenCustomTabColorsTabbedPage"/>
            </VerticalStackLayout>

            <!-- Gradient Background -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Gradient Bar Background"/>
                <Label StyleClass="h3"
                       Text="TabbedPage with gradient BarBackground brush."/>
                <Button Text="Gradient Background"
                        Clicked="OnOpenGradientTabbedPage"/>
            </VerticalStackLayout>

            <!-- Dynamic Tabs -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Dynamic Tabs"/>
                <Label StyleClass="h3"
                       Text="Add and remove tabs dynamically."/>
                <Button Text="Dynamic Tab Demo"
                        Clicked="OnOpenDynamicTabbedPage"/>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

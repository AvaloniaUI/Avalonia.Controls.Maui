<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.WelcomePage"
             Title="Welcome">

    <ScrollView>
        <VerticalStackLayout>
            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BannerLight}, Dark={StaticResource BannerDark}}">
                <Image Source="{AppThemeBinding Light='banner_light.png', Dark='banner_dark.png'}"
                       Aspect="AspectFit"
                       HorizontalOptions="Fill"
                       MaximumHeightRequest="300"
                       Margin="0,20,0,0" />
            </Grid>

            <controls:PageLayout>
                <Label StyleClass="h2"
                       Text="Run your .NET MAUI apps on Windows, macOS, Linux, and the Browser with pixel-perfect rendering." />

                <VerticalStackLayout StyleClass="section">
                    <Label StyleClass="h1"
                           Text="Key Features" />
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="24"
                          RowSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Cross-Platform"
                                   FontAttributes="Bold" />
                            <Label StyleClass="h3"
                                   Text="One codebase for Mobile, Desktop and Web scenarios." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4">
                            <Label Text="Pixel Perfect"
                                   FontAttributes="Bold" />
                            <Label StyleClass="h3"
                                   Text="Consistent look and feel across all platforms." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1"
                                             Spacing="4">
                            <Label Text="High Performance"
                                   FontAttributes="Bold" />
                            <Label StyleClass="h3"
                                   Text="Built on top of Avalonia's rendering engine." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1"
                                             Grid.Column="1"
                                             Spacing="4">
                            <Label Text="MAUI Compatible"
                                   FontAttributes="Bold" />
                            <Label StyleClass="h3"
                                   Text="Use existing .NET MAUI controls and layouts." />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <Label StyleClass="h3"
                       Text="Select a sample from the menu to get started." />
            </controls:PageLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

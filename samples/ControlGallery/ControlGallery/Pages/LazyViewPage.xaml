<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ControlGallery.Pages.LazyViewPage"
             Title="LazyView">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <!-- Load on Demand -->
            <Border Stroke="Gray"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Load on Demand"
                           FontAttributes="Bold"/>
                    <Label Text="The view inside a LazyView is created only when LoadViewAsync is called."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"/>
                    <Button Text="Load View"
                            HorizontalOptions="Start"
                            Clicked="OnLoadViewClicked"/>
                    <Label x:Name="OnDemandStatusLabel"
                           Text="HasLazyViewLoaded: False"/>
                    <ContentView x:Name="OnDemandHost"/>
                </VerticalStackLayout>
            </Border>

            <!-- Slow Loading -->
            <Border Stroke="Gray"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Slow Loading"
                           FontAttributes="Bold"/>
                    <Label Text="A custom LazyView shows an activity indicator while it prepares its content."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"/>
                    <Button Text="Load Slow View"
                            HorizontalOptions="Start"
                            Clicked="OnLoadSlowViewClicked"/>
                    <Label x:Name="SlowStatusLabel"
                           Text="HasLazyViewLoaded: False"/>
                    <ContentView x:Name="SlowHost"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

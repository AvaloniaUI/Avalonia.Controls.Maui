<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.MapPage"
             x:DataType="pages:MapPage"
             Title="Map">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Displays an interactive map with pins, shapes and the user's location." />

            <!-- Basic Map -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic Map" />
                <Label StyleClass="h3"
                       Text="A simple map displaying OpenStreetMap tiles." />
                <maps:Map x:Name="BasicMap"
                           HeightRequest="300"
                           WidthRequest="350"
                           HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Map Type -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Map Type" />
                <Label StyleClass="h3"
                       Text="Switch between different map styles (Street, Satellite, Hybrid)." />
                <maps:Map x:Name="MapTypeMap"
                           HeightRequest="300" />
                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                     <Label Text="Type:" VerticalOptions="Center" />
                     <Picker x:Name="MapTypePicker"
                             SelectedIndexChanged="OnMapTypeChanged"
                             WidthRequest="150">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Street</x:String>
                                <x:String>Satellite</x:String>
                                <x:String>Hybrid</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                    </Picker>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- User Position -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="User Location" />
                <Label StyleClass="h3"
                       Text="Automatically shows your current location with a custom indicator." />
                <maps:Map x:Name="UserLocationMap"
                           HeightRequest="300" />
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Map Clicked" />
                <Label StyleClass="h3"
                       Text="Click on the map to see coordinates." />
                <Label x:Name="ClickedCoordsLabel"
                       Text="Click anywhere on the map..."
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="#2196F3"
                       Margin="0,0,0,8" />
                <maps:Map x:Name="ClickableMap"
                           HeightRequest="250" />
            </VerticalStackLayout>

            <!-- Map Selection (Pins & Shapes) -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pin and Shape Selection" />
                <Label StyleClass="h3"
                       Text="Click on pins or shapes to see their details." />
                <Label x:Name="SelectionInfoLabel"
                       Text="Click on a pin or shape..."
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="#4CAF50"
                       Margin="0,0,0,8" />
                <maps:Map x:Name="SelectionMap"
                           HeightRequest="300"
                           MapClicked="OnSelectionMapClicked" />
            </VerticalStackLayout>

            <!-- Pins -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pins" />
                <Label StyleClass="h3"
                       Text="Add and remove pins on the map." />
                <Label x:Name="PinsCountLabel"
                       Text="Pins: 0"
                       FontSize="14"
                       TextColor="#4CAF50"
                       Margin="0,0,0,8" />
                <maps:Map x:Name="PinsMap"
                           HeightRequest="300" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <Button Text="Add Rome" Clicked="OnAddRomePinClicked" Margin="0,0,8,8" />
                    <Button Text="Add Paris" Clicked="OnAddParisPinClicked" Margin="0,0,8,8" />
                    <Button Text="Add Berlin" Clicked="OnAddBerlinPinClicked" Margin="0,0,8,8" />
                    <Button Text="Clear All" Clicked="OnClearPinsClicked" Margin="0,0,8,8" />
                </FlexLayout>
            </VerticalStackLayout>

            <!-- ItemsSource & ItemTemplate -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="ItemsSource Binding" />
                <Label StyleClass="h3"
                       Text="Bind a collection of custom data objects to the map pins." />

                <maps:Map x:Name="ItemsSourceMap"
                           HeightRequest="300"
                           ItemsSource="{Binding PlaceData}">
                    <maps:Map.ItemTemplate>
                        <DataTemplate x:DataType="pages:PlaceItem">
                            <maps:Pin Label="{Binding Name}"
                                      Location="{Binding Position}"
                                      Address="{Binding Description}" />
                        </DataTemplate>
                    </maps:Map.ItemTemplate>
                </maps:Map>

                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <Button Text="Add Madrid" Clicked="OnAddMadridDataClicked" Margin="0,0,8,8" />
                    <Button Text="Add Barcelona" Clicked="OnAddBarcelonaDataClicked" Margin="0,0,8,8" />
                    <Button Text="Clear Data" Clicked="OnClearDataClicked" Margin="0,0,8,8" />
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Scroll and Zoom Control -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Scroll and Zoom Control" />
                <Label StyleClass="h3"
                       Text="Showing Sevilla, Spain. Enable or disable map interactions." />
                <maps:Map x:Name="InteractionMap"
                           HeightRequest="250" />
                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="Zoom:" VerticalOptions="Center" />
                    <Slider x:Name="ZoomSlider"
                            Minimum="1"
                            Maximum="18"
                            Value="12"
                            WidthRequest="200"
                            ValueChanged="OnZoomSliderChanged" />
                    <Label x:Name="ZoomLevelLabel"
                           Text="12"
                           WidthRequest="30"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="Scroll Enabled:" VerticalOptions="Center" />
                        <Switch x:Name="ScrollSwitch"
                                IsToggled="True"
                                Toggled="OnScrollSwitchToggled" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="Zoom Enabled:" VerticalOptions="Center" />
                        <Switch x:Name="ZoomSwitch"
                                IsToggled="True"
                                Toggled="OnZoomSwitchToggled" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Shapes (Polygons, Polylines, Circles) -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Shapes" />
                <Label StyleClass="h3"
                       Text="Draw polygons, polylines, and circles on the map." />
                <Label x:Name="ShapesCountLabel"
                       Text="Shapes: 0"
                       FontSize="14"
                       TextColor="#FF5722"
                       Margin="0,0,0,8" />
                <maps:Map x:Name="ShapesMap"
                           HeightRequest="300" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <Button Text="Add Polygon" Clicked="OnAddPolygonClicked" Margin="0,0,8,8" />
                    <Button Text="Add Polyline" Clicked="OnAddPolylineClicked" Margin="0,0,8,8" />
                    <Button Text="Add Circle" Clicked="OnAddCircleClicked" Margin="0,0,8,8" />
                    <Button Text="Clear Shapes" Clicked="OnClearShapesClicked" Margin="0,0,8,8" />
                </FlexLayout>
            </VerticalStackLayout>



            <!-- Move to Region -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Move to Region" />
                <Label StyleClass="h3"
                       Text="Navigate to specific locations on the map." />
                <Label x:Name="CurrentLocationLabel"
                       Text="Current: New York, USA"
                       FontSize="14"
                       FontAttributes="Italic"
                       TextColor="#4CAF50"
                       Margin="0,0,0,8" />
                <maps:Map x:Name="RegionMap"
                           HeightRequest="300" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <Button Text="New York" Clicked="OnMoveToNYCClicked" Margin="0,0,8,8" />
                    <Button Text="London" Clicked="OnMoveToLondonClicked" Margin="0,0,8,8" />
                    <Button Text="Tokyo" Clicked="OnMoveToTokyoClicked" Margin="0,0,8,8" />
                    <Button Text="Sydney" Clicked="OnMoveToSydneyClicked" Margin="0,0,8,8" />
                </FlexLayout>
            </VerticalStackLayout>



        </controls:PageLayout>
    </ScrollView>
</ContentPage>

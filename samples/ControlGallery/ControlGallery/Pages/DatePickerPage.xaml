<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.DatePickerPage"
             Title="DatePicker">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="The DatePicker invokes the platform's selection interface and allows the user to select a date." />

            <!-- Basic DatePicker -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic DatePicker" />
                <Label StyleClass="h3"
                       Text="A simple date picker with the DateSelected event." />
                <DatePicker x:Name="BasicDatePicker"
                            DateSelected="OnBasicDateSelected" />
                <Label x:Name="SelectedDateLabel"
                       Text="Selected date: (none)"
                       FontAttributes="Italic" />
            </VerticalStackLayout>

            <!-- Date Range -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Date Range (MinimumDate / MaximumDate)" />
                <Label StyleClass="h3"
                       Text="Restricts the selectable date range. This picker only allows dates in 2024." />
                <DatePicker x:Name="RangeDatePicker"
                            MinimumDate="01/01/2024"
                            MaximumDate="12/31/2024"
                            Date="06/15/2024"
                            DateSelected="OnRangeDateSelected" />
                <Label x:Name="RangeDateLabel"
                       Text="Date: June 15, 2024"
                       FontAttributes="Italic" />
            </VerticalStackLayout>

            <!-- Custom Format -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Custom Format" />
                <Label StyleClass="h3"
                       Text="The Format property controls how the date is displayed." />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Short date (d):"
                           FontSize="12" />
                    <DatePicker Format="d" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Long date (D):"
                           FontSize="12" />
                    <DatePicker Format="D" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Month/Day (M):"
                           FontSize="12" />
                    <DatePicker Format="M" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Year/Month (Y):"
                           FontSize="12" />
                    <DatePicker Format="Y" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Text Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Text Color" />
                <Label StyleClass="h3"
                       Text="TextColor sets the color of the displayed date." />

                <FlexLayout Wrap="Wrap" 
                            JustifyContent="Start" 
                            AlignItems="Start" 
                            Direction="Row">
                    <DatePicker TextColor="Red" Margin="0,0,16,8" />
                    <DatePicker TextColor="Green" Margin="0,0,16,8" />
                    <DatePicker TextColor="Blue" Margin="0,0,16,8" />
                </FlexLayout>

                <DatePicker TextColor="#9333ea" />
            </VerticalStackLayout>

            <!-- Font Styling -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Font Styling" />
                <Label StyleClass="h3"
                       Text="FontSize, FontAttributes, and FontFamily customize the appearance." />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Large (FontSize=20):"
                           FontSize="12" />
                    <DatePicker FontSize="20" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Bold:"
                           FontSize="12" />
                    <DatePicker FontAttributes="Bold" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Italic:"
                           FontSize="12" />
                    <DatePicker FontAttributes="Italic" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Bold + Large + Colored:"
                           FontSize="12" />
                    <DatePicker FontAttributes="Bold"
                                FontSize="18"
                                TextColor="#2563eb" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Character Spacing -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Character Spacing" />
                <Label StyleClass="h3"
                       Text="CharacterSpacing increases the space between characters (limited support)." />
                <DatePicker CharacterSpacing="6"
                            FontSize="16" />
            </VerticalStackLayout>

            <!-- Programmatic Selection -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Programmatic Selection" />
                <Label StyleClass="h3"
                       Text="Set the date programmatically using buttons." />
                <DatePicker x:Name="ProgrammaticDatePicker" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Today"
                            Clicked="OnSetTodayClicked"
                            HorizontalOptions="Start" />
                    <Button Text="Clear"
                            Clicked="OnClearDateClicked"
                            HorizontalOptions="Start" />
                    <Button Text="Set to 2025"
                            Clicked="OnSetTo2025Clicked"
                            HorizontalOptions="Start" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Disabled State -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Disabled State" />
                <Label StyleClass="h3"
                       Text="A DatePicker with IsEnabled set to False." />
                <DatePicker IsEnabled="False"
                            Date="01/01/2024" />
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

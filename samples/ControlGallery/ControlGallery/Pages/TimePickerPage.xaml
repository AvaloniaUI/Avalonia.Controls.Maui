<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.TimePickerPage"
             Title="TimePicker">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="The TimePicker invokes the platform's selection interface and allows the user to select a time." />

            <!-- Basic TimePicker -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic TimePicker" />
                <Label StyleClass="h3"
                       Text="A simple time picker with data binding." />
                <TimePicker x:Name="BasicTimePicker" />
                <Label x:DataType="TimePicker"
                       Text="{Binding Source={x:Reference BasicTimePicker}, Path=Time, StringFormat='Selected Time: {0}'}"
                       FontAttributes="Italic" />
            </VerticalStackLayout>

            <!-- Preselected Time -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Preselected Time" />
                <Label StyleClass="h3"
                       Text="A TimePicker initialized with a specific time (14:30:00)." />
                <TimePicker Time="14:30:00" />
            </VerticalStackLayout>

            <!-- Format Variations -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Format Variations" />
                <Label StyleClass="h3"
                       Text="The Format property controls the clock display (12h vs 24h)." />

                <VerticalStackLayout Spacing="4">
                    <Label Text="12-hour format (h:mm tt):"
                           FontSize="12" />
                    <TimePicker Format="h:mm tt"
                                Time="16:20:00" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="24-hour format (HH:mm):"
                           FontSize="12" />
                    <TimePicker Format="HH:mm"
                                Time="16:45:00" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Short time (t):"
                           FontSize="12" />
                    <TimePicker Format="t"
                                Time="09:30:00" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Long time (T):"
                           FontSize="12" />
                    <TimePicker Format="T"
                                Time="21:15:00" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Text Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Text Color" />
                <Label StyleClass="h3"
                       Text="TextColor sets the color of the displayed time." />

                <FlexLayout Wrap="Wrap" 
                            JustifyContent="Start" 
                            AlignItems="Start" 
                            Direction="Row">
                    <TimePicker TextColor="Red" Time="08:00:00" Margin="0,0,16,8" />
                    <TimePicker TextColor="Green" Time="12:00:00" Margin="0,0,16,8" />
                    <TimePicker TextColor="Blue" Time="18:00:00" Margin="0,0,16,8" />
                </FlexLayout>

                <TimePicker TextColor="#9333ea" Time="22:00:00" />
            </VerticalStackLayout>

            <!-- Font Styling -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Font Styling" />
                <Label StyleClass="h3"
                       Text="FontSize, FontAttributes, and FontFamily customize the appearance." />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Large (FontSize=20):"
                           FontSize="12" />
                    <TimePicker FontSize="20" Time="10:00:00" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Bold:"
                           FontSize="12" />
                    <TimePicker FontAttributes="Bold" Time="11:00:00" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Italic:"
                           FontSize="12" />
                    <TimePicker FontAttributes="Italic" Time="12:00:00" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Bold + Large + Colored:"
                           FontSize="12" />
                    <TimePicker FontAttributes="Bold"
                                FontSize="18"
                                TextColor="#2563eb"
                                Time="13:30:00" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Character Spacing -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Character Spacing" />
                <Label StyleClass="h3"
                       Text="CharacterSpacing increases the space between characters (limited support)." />
                <TimePicker CharacterSpacing="6"
                            FontSize="16"
                            Time="15:00:00" />
            </VerticalStackLayout>

            <!-- Programmatic Control -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Programmatic Selection" />
                <Label StyleClass="h3"
                       Text="Set the time programmatically using buttons." />
                <TimePicker x:Name="ProgrammaticTimePicker" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="8:00 AM"
                            Clicked="OnSetTime8Clicked"
                            HorizontalOptions="Start" />
                    <Button Text="12:00 PM"
                            Clicked="OnSetTime12Clicked"
                            HorizontalOptions="Start" />
                    <Button Text="5:00 PM"
                            Clicked="OnSetTime17Clicked"
                            HorizontalOptions="Start" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Disabled State -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Disabled State" />
                <Label StyleClass="h3"
                       Text="A TimePicker with IsEnabled set to False." />
                <TimePicker IsEnabled="False"
                            Time="09:00:00" />
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ControlGallery.Pages.AvatarViewPage"
             Title="AvatarView">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Shows a person's initials or picture in a round frame." />

            <!-- Initials -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Initials" />
                <Label StyleClass="h3"
                       Text="An avatar shows text, such as a person's initials, when it has no image." />
                <HorizontalStackLayout Spacing="10">
                    <toolkit:AvatarView Text="AB"/>
                    <toolkit:AvatarView Text="CD"
                                        BackgroundColor="{AppThemeBinding Light=#6200EE, Dark=#03DAC5}"
                                        TextColor="White"/>
                    <toolkit:AvatarView Text="EF"
                                        BackgroundColor="Orange"
                                        TextColor="Black"
                                        FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Image -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Image" />
                <Label StyleClass="h3"
                       Text="When ImageSource is set, the avatar shows the image instead of the text." />
                <HorizontalStackLayout Spacing="10">
                    <toolkit:AvatarView Text="NET"
                                        ImageSource="dotnet_logo.png"
                                        Padding="0"/>
                    <toolkit:AvatarView Text="NET"
                                        ImageSource="dotnet_logo.png"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        CornerRadius="40"
                                        Padding="0"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Sizes -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Sizes" />
                <Label StyleClass="h3"
                       Text="The avatar can be any size. The text scales with FontSize." />
                <HorizontalStackLayout Spacing="10">
                    <toolkit:AvatarView Text="S"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        CornerRadius="16"
                                        FontSize="12"/>
                    <toolkit:AvatarView Text="M"
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        CornerRadius="28"
                                        FontSize="20"/>
                    <toolkit:AvatarView Text="L"
                                        WidthRequest="96"
                                        HeightRequest="96"
                                        CornerRadius="48"
                                        FontSize="36"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Border -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Border" />
                <Label StyleClass="h3"
                       Text="BorderColor and BorderWidth draw an outline around the avatar." />
                <HorizontalStackLayout Spacing="10">
                    <toolkit:AvatarView Text="1"
                                        BorderColor="Red"
                                        BorderWidth="1"/>
                    <toolkit:AvatarView Text="3"
                                        BorderColor="Green"
                                        BorderWidth="3"/>
                    <toolkit:AvatarView Text="6"
                                        BorderColor="{AppThemeBinding Light=#6200EE, Dark=#03DAC5}"
                                        BorderWidth="6"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Corner Radius -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Corner Radius" />
                <Label StyleClass="h3"
                       Text="CornerRadius sets the shape, from a circle to a rounded square." />
                <HorizontalStackLayout Spacing="10">
                    <toolkit:AvatarView Text="O"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        CornerRadius="32"/>
                    <toolkit:AvatarView Text="R"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        CornerRadius="12"/>
                    <toolkit:AvatarView Text="M"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        CornerRadius="32,0,32,0"/>
                    <toolkit:AvatarView Text="S"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        CornerRadius="0"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.CheckBoxPage"
             Title="CheckBox">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="A box that the user can check or uncheck."/>

            <!-- Basic CheckBoxes -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic CheckBoxes"/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="False"
                              CheckedChanged="OnCheckBoxChanged"/>
                    <Label Text="Unchecked by default"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              CheckedChanged="OnCheckBoxChanged"/>
                    <Label Text="Checked by default"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsEnabled="False"/>
                    <Label Text="Disabled (unchecked)"
                           VerticalOptions="Center"
                           TextColor="Gray"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              IsEnabled="False"/>
                    <Label Text="Disabled (checked)"
                           VerticalOptions="Center"
                           TextColor="Gray"/>
                </HorizontalStackLayout>

                <Label x:Name="CheckCountLabel"
                       Text="Check/Uncheck count: 0"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Colored CheckBoxes"/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              Color="Red"/>
                    <Label Text="Red"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              Color="Green"/>
                    <Label Text="Green"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              Color="Blue"/>
                    <Label Text="Blue"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              Color="Orange"/>
                    <Label Text="Orange"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              Color="Purple"/>
                    <Label Text="Purple"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="False"
                              Color="Red"/>
                    <Label Text="Red (unchecked)"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Height -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Minimum Height"/>
                <Label StyleClass="h3"
                       Text="Check boxes with a MinimumHeightRequest of 44, shaded to show their height, next to vertically centered labels."/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              MinimumHeightRequest="44"
                              BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"/>
                    <Label Text="Checked"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="False"
                              MinimumHeightRequest="44"
                              BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"/>
                    <Label Text="Unchecked"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="True"
                              HeightRequest="64"
                              BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"/>
                    <Label Text="HeightRequest 64"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Grouped CheckBoxes - Single Selection -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Preference Selection (Multiple Choice)"/>
                <Label StyleClass="h3"
                       Text="Select your favorite fruits:"/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="AppleCheckBox"
                              CheckedChanged="OnFruitCheckedChanged"/>
                    <Label Text="Apple"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="BananaCheckBox"
                              CheckedChanged="OnFruitCheckedChanged"/>
                    <Label Text="Banana"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="OrangeCheckBox"
                              CheckedChanged="OnFruitCheckedChanged"/>
                    <Label Text="Orange"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="GrapeCheckBox"
                              CheckedChanged="OnFruitCheckedChanged"/>
                    <Label Text="Grape"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label x:Name="FruitSelectionLabel"
                       Text="No fruits selected"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"
                       TextColor="DarkBlue"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- Settings Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Settings Example"/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="NotificationsCheckBox"
                              IsChecked="True"
                              CheckedChanged="OnSettingChanged"/>
                    <Label Text="Enable Notifications"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="DarkModeCheckBox"
                              CheckedChanged="OnSettingChanged"/>
                    <Label Text="Dark Mode"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="AutoSaveCheckBox"
                              IsChecked="True"
                              CheckedChanged="OnSettingChanged"/>
                    <Label Text="Auto-Save"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="LocationCheckBox"
                              CheckedChanged="OnSettingChanged"/>
                    <Label Text="Share Location"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label x:Name="SettingsLabel"
                       Text="Settings: Notifications ✓, Auto-Save ✓"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"
                       TextColor="DarkGreen"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- Task List Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Task List Example"/>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="Task1CheckBox"
                              CheckedChanged="OnTaskCheckedChanged"
                              Color="Green"/>
                    <Label Text="Complete project proposal"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="Task2CheckBox"
                              CheckedChanged="OnTaskCheckedChanged"
                              Color="Green"/>
                    <Label Text="Review code changes"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="Task3CheckBox"
                              CheckedChanged="OnTaskCheckedChanged"
                              Color="Green"/>
                    <Label Text="Update documentation"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="Task4CheckBox"
                              CheckedChanged="OnTaskCheckedChanged"
                              Color="Green"/>
                    <Label Text="Attend team meeting"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="Task5CheckBox"
                              CheckedChanged="OnTaskCheckedChanged"
                              Color="Green"/>
                    <Label Text="Send weekly report"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label x:Name="TaskProgressLabel"
                       Text="Progress: 0/5 tasks completed (0%)"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"
                       TextColor="DarkOrange"
                       Margin="0,10,0,0"/>

                <ProgressBar x:Name="TaskProgressBar"
                             Progress="0"
                             ProgressColor="Green"
                             HeightRequest="10"/>
            </VerticalStackLayout>

            <!-- Interactive Demo -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Interactive CheckBox Demo"/>

                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <CheckBox x:Name="InteractiveCheckBox"
                              IsChecked="False"
                              Color="Blue"
                              CheckedChanged="OnInteractiveCheckChanged"/>
                    <Label x:Name="InteractiveLabel"
                           Text="I'm unchecked"
                           VerticalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <Label Text="Change CheckBox Color:"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Button Text="Red"
                            Clicked="OnSetColorRed"
                            BackgroundColor="Red"
                            TextColor="White"
                            WidthRequest="80"/>
                    <Button Text="Green"
                            Clicked="OnSetColorGreen"
                            BackgroundColor="Green"
                            TextColor="White"
                            WidthRequest="80"/>
                    <Button Text="Blue"
                            Clicked="OnSetColorBlue"
                            BackgroundColor="Blue"
                            TextColor="White"
                            WidthRequest="80"/>
                    <Button Text="Purple"
                            Clicked="OnSetColorPurple"
                            BackgroundColor="Purple"
                            TextColor="White"
                            WidthRequest="80"/>
                </HorizontalStackLayout>

                <Label Text="Quick Actions:"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="0,10,0,0"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Button Text="Check"
                            Clicked="OnCheckInteractive"
                            WidthRequest="100"/>
                    <Button Text="Uncheck"
                            Clicked="OnUncheckInteractive"
                            WidthRequest="100"/>
                    <Button Text="Toggle"
                            Clicked="OnToggleInteractive"
                            WidthRequest="100"/>
                </HorizontalStackLayout>

                <Label x:Name="InteractionCountLabel"
                       Text="Interactions: 0"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"
                       TextColor="Gray"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.PreferencesPage"
             Title="Preferences">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Stores and reads simple values that persist between app launches." />

            <!-- String Preferences -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="String Preference" />
                <Entry x:Name="StringEntry"
                       Placeholder="Enter a value"/>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Save"
                            Clicked="OnSaveStringClicked"/>
                    <Button Text="Load"
                            Clicked="OnLoadStringClicked"/>
                    <Button Text="Remove"
                            Clicked="OnRemoveStringClicked"/>
                </HorizontalStackLayout>
                <Label x:Name="StringResultLabel"
                       Text="Value: --"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- Numeric Preferences -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Counter (int preference)" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Increment"
                            Clicked="OnIncrementClicked"/>
                    <Button Text="Reset"
                            Clicked="OnResetCounterClicked"/>
                </HorizontalStackLayout>
                <Label x:Name="CounterLabel"
                       Text="Count: 0"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- Bool / Switch -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Boolean Preference" />
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Notifications enabled:"
                           VerticalOptions="Center"/>
                    <Switch x:Name="BoolSwitch"
                            Toggled="OnBoolSwitchToggled"/>
                </HorizontalStackLayout>
                <Label x:Name="BoolResultLabel"
                       Text="Stored: --"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- DateTime -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="DateTime Preference" />
                <Button Text="Save Current Time"
                        Clicked="OnSaveDateTimeClicked"/>
                <Button Text="Load Saved Time"
                        Clicked="OnLoadDateTimeClicked"/>
                <Label x:Name="DateTimeResultLabel"
                       Text="Saved: --"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- Shared Containers -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Shared Containers" />
                <Label StyleClass="h3"
                       Text="Same key stored in two containers:" />
                <Button Text="Save to Both"
                        Clicked="OnSaveSharedClicked"/>
                <Label x:Name="SharedDefaultLabel"
                       Text="Default: --"
                       FontAttributes="Italic"/>
                <Label x:Name="SharedNamedLabel"
                       Text="Named: --"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- Clear All -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Danger Zone" />
                <Button Text="Clear All Preferences"
                        TextColor="Red"
                        Clicked="OnClearAllClicked"/>
                <Label x:Name="ClearResultLabel"
                       Text=""
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

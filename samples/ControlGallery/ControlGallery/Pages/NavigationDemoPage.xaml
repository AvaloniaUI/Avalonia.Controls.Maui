<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             x:Class="ControlGallery.Pages.NavigationDemoPage"
             x:DataType="pages:NavigationDemoPage"
             Title="Navigation Demo"
             NavigationPage.HasNavigationBar="True">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="This demo shows NavigationPage features including navigation bar customization, back button title, title icon, and page navigation."/>

            <!-- Page Transitions -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Page Transitions"/>
                <Label StyleClass="h3"
                       Text="Change the transition animation used when pushing and popping pages."/>
                <Label x:Name="CurrentTransitionLabel"
                       Text="Current: Default"
                       FontSize="12"
                       TextColor="Gray"/>
                <Button Text="Default (Parallax)"
                        Clicked="OnSetDefaultTransition"/>
                <Button Text="Simple Slide"
                        Clicked="OnSetSlideTransition"/>
                <Button Text="Cross Fade"
                        Clicked="OnSetCrossFadeTransition"/>
                <Button Text="Fast (150ms)"
                        Clicked="OnSetFastTransition"/>
                <Button Text="Slow (800ms)"
                        Clicked="OnSetSlowTransition"/>
                <Button Text="No Animation"
                        Clicked="OnSetNoTransition"/>
            </VerticalStackLayout>

            <!-- Basic Navigation -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic Navigation"/>
                <Label StyleClass="h3"
                       Text="Push pages onto the navigation stack and use the back button to return."/>
                <Button Text="Push Simple Page"
                        Clicked="OnPushSimplePage"/>
                <Button Text="Push Page with Custom Back Title"
                        Clicked="OnPushPageWithBackTitle"/>
                <Button Text="Push Page without Navigation Bar"
                        Clicked="OnPushPageWithoutNavBar"/>
            </VerticalStackLayout>

            <!-- Navigation Bar Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Navigation Bar Colors"/>
                <Label StyleClass="h3"
                       Text="Change BarBackgroundColor and BarTextColor."/>
                <Button Text="Blue Bar"
                        Clicked="OnSetBlueBar"/>
                <Button Text="Dark Theme Bar"
                        Clicked="OnSetDarkBar"/>
                <Button Text="Green Bar"
                        Clicked="OnSetGreenBar"/>
                <Button Text="Reset to Default"
                        Clicked="OnResetBar"/>
            </VerticalStackLayout>

            <!-- Gradient Background -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="BarBackground (Brush)"/>
                <Label StyleClass="h3"
                       Text="Use gradient brushes for the navigation bar background."/>
                <Button Text="Gradient Background"
                        Clicked="OnSetGradientBar"/>
                <Button Text="Radial Gradient"
                        Clicked="OnSetRadialGradientBar"/>
            </VerticalStackLayout>

            <!-- Title View and Icon -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Title View and Icon"/>
                <Label StyleClass="h3"
                       Text="Push pages with custom TitleView or TitleIconImageSource."/>
                <Button Text="Push Page with Title Icon"
                        Clicked="OnPushPageWithTitleIcon"/>
                <Button Text="Push Page with Custom TitleView"
                        Clicked="OnPushPageWithTitleView"/>
            </VerticalStackLayout>

            <!-- Icon Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Icon Color"/>
                <Label StyleClass="h3"
                       Text="Customize the back button icon color per page."/>
                <Button Text="Push Page with Red Icon"
                        Clicked="OnPushPageWithRedIcon"/>
                <Button Text="Push Page with Blue Icon"
                        Clicked="OnPushPageWithBlueIcon"/>
            </VerticalStackLayout>

            <!-- HasBackButton -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="HasBackButton"/>
                <Label StyleClass="h3"
                       Text="Hide the back button on a page."/>
                <Button Text="Push Page without Back Button"
                        Clicked="OnPushPageWithoutBackButton"/>
            </VerticalStackLayout>

            <!-- Navigation Stack Info -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Navigation Stack Info"/>
                <Label x:Name="StackInfoLabel"
                       Text="Stack depth: 1"
                       FontSize="12"/>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

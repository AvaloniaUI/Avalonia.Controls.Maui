<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.DragAndDropPage"
             Title="Drag &amp; Drop">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Drags content from a source and drops it on a target." />

            <Border Background="#33FFA500"
                    Stroke="Orange"
                    StrokeThickness="1"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Label Text="⚠ Temporarily unavailable: drag &amp; drop gesture recognizers are pending a public MAUI IGesturePlatformManager API (dotnet/maui#33364), so the samples below will not respond. See docs/known-issues.md."
                       FontSize="13"/>
            </Border>

            <!-- Text Drag/Drop -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Text Drag and Drop" />
                <Label StyleClass="h3"
                       Text="Drag from source to target" />

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <!-- Drag Source -->
                    <Border BackgroundColor="CornflowerBlue"
                            WidthRequest="120"
                            HeightRequest="80"
                            StrokeThickness="1"
                            Stroke="Gray">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer DragStarting="OnDragStarting" DropCompleted="OnDropCompleted"/>
                        </Border.GestureRecognizers>
                        <Label Text="Drag Me"
                               TextColor="White"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>

                    <Label Text="->"
                           VerticalOptions="Center"
                           FontSize="24"/>

                    <!-- Drop Target -->
                    <Border x:Name="DropTarget1"
                            BackgroundColor="LightGray"
                            WidthRequest="120"
                            HeightRequest="80"
                            StrokeThickness="2"
                            Stroke="DarkGray">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DropGestureRecognizer DragOver="OnDragOver1" Drop="OnDrop1"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="DropLabel1"
                               Text="Drop Here"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
                <Label x:Name="DragDropStatus1" Text="Status: Ready" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Multiple Sources -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Multiple Drag Sources" />
                <Label StyleClass="h3"
                       Text="Drag any colored box to the drop zone" />

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border BackgroundColor="Coral"
                            WidthRequest="80" HeightRequest="60"
                            StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer DragStarting="OnMultiDragStarting"/>
                        </Border.GestureRecognizers>
                        <Label Text="Red" TextColor="White" FontAttributes="Bold"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>

                    <Border BackgroundColor="MediumSeaGreen"
                            WidthRequest="80" HeightRequest="60"
                            StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer DragStarting="OnMultiDragStarting"/>
                        </Border.GestureRecognizers>
                        <Label Text="Green" TextColor="White" FontAttributes="Bold"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>

                    <Border BackgroundColor="MediumPurple"
                            WidthRequest="80" HeightRequest="60"
                            StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer DragStarting="OnMultiDragStarting"/>
                        </Border.GestureRecognizers>
                        <Label Text="Purple" TextColor="White" FontAttributes="Bold"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>

                <Border x:Name="MultiDropTarget"
                        BackgroundColor="LightGray"
                        HeightRequest="60"
                        StrokeThickness="2"
                        Stroke="DarkGray">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <DropGestureRecognizer Drop="OnMultiDrop"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="MultiDropLabel"
                           Text="Drop zone"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <!-- DragOver Feedback -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="DragOver Feedback" />
                <Label StyleClass="h3"
                       Text="Drop zone changes color when hovering" />

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Border BackgroundColor="DarkSlateBlue"
                            WidthRequest="100" HeightRequest="60"
                            StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DragGestureRecognizer DragStarting="OnFeedbackDragStarting"/>
                        </Border.GestureRecognizers>
                        <Label Text="Drag Me" TextColor="White" FontAttributes="Bold"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>

                    <Border x:Name="FeedbackDropTarget"
                            BackgroundColor="LightGray"
                            WidthRequest="150" HeightRequest="60"
                            StrokeThickness="2"
                            Stroke="DarkGray">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <DropGestureRecognizer DragOver="OnFeedbackDragOver"
                                                   DragLeave="OnFeedbackDragLeave"
                                                   Drop="OnFeedbackDrop"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="FeedbackDropLabel"
                               Text="Hover over me"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Cancel Drag -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Cancel Drag" />
                <Label StyleClass="h3"
                       Text="DragStarting handler sets Cancel=true" />

                <Border BackgroundColor="IndianRed"
                        HeightRequest="60"
                        StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <DragGestureRecognizer DragStarting="OnCancelledDragStarting"/>
                    </Border.GestureRecognizers>
                    <Label Text="Try to drag (cancelled)"
                           TextColor="White"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>
                <Label x:Name="CancelDragStatus" Text="Status: Not attempted" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- CanDrag/AllowDrop Toggles -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="CanDrag / AllowDrop Toggles" />
                <Label StyleClass="h3"
                       Text="Toggle properties dynamically" />

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="5">
                        <Border x:Name="ToggleDragSource"
                                BackgroundColor="Teal"
                                WidthRequest="100" HeightRequest="60"
                                StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <DragGestureRecognizer x:Name="ToggleDragRecognizer"
                                                       CanDrag="True"
                                                       DragStarting="OnToggleDragStarting"/>
                            </Border.GestureRecognizers>
                            <Label Text="Drag" TextColor="White" FontAttributes="Bold"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Border>
                        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="CanDrag:" VerticalOptions="Center" FontSize="12"/>
                            <Switch x:Name="CanDragSwitch" IsToggled="True" Toggled="OnCanDragToggled"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Border x:Name="ToggleDropTarget"
                                BackgroundColor="LightGray"
                                WidthRequest="100" HeightRequest="60"
                                StrokeThickness="2"
                                Stroke="DarkGray">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <DropGestureRecognizer x:Name="ToggleDropRecognizer"
                                                       AllowDrop="True"
                                                       Drop="OnToggleDrop"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="ToggleDropLabel"
                                   Text="Drop"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>
                        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="AllowDrop:" VerticalOptions="Center" FontSize="12"/>
                            <Switch x:Name="AllowDropSwitch" IsToggled="True" Toggled="OnAllowDropToggled"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Label x:Name="ToggleStatus" Text="Status: Ready" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- External File Drop -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="External File Drop" />
                <Label StyleClass="h3"
                       Text="Drag files from your file manager into the drop zone" />

                <Border x:Name="FileDropTarget"
                        BackgroundColor="LightGray"
                        HeightRequest="120"
                        StrokeThickness="2"
                        Stroke="DarkGray"
                        StrokeDashArray="4,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <DropGestureRecognizer DragOver="OnFileDragOver"
                                               DragLeave="OnFileDragLeave"
                                               Drop="OnFileDrop"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="FileDropLabel"
                           Text="Drop files here"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>
                <Label x:Name="FileDropStatus" Text="No files dropped" HorizontalOptions="Center" FontSize="12"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

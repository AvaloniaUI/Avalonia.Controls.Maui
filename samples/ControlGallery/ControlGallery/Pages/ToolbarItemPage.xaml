<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.ToolbarItemPage"
             Title="ToolbarItems">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" 
                     IconImageSource="slider_thumb.png"
                     Clicked="OnEditClicked" 
                     Order="Primary"
                     Priority="0" />
        <ToolbarItem Text="Delete" 
                     IconImageSource="redbug.png"
                     Clicked="OnDeleteClicked" 
                     Order="Primary"
                     Priority="1" />
        <ToolbarItem Text="TextOnly" 
                     Clicked="OnTextOnlyClicked" 
                     Order="Primary" 
                     Priority="2"/>
         <ToolbarItem Text="Secondary" 
                     Clicked="OnSecondaryClicked"
                     Order="Secondary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Adds, removes and changes the toolbar items of a page."/>

            <!-- Basic Actions (Primary) -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Primary Items"/>
                <Label StyleClass="h3"
                       Text="Control primary items programmatically."/>
                <Label x:Name="PrimaryLogLabel" 
                       Text="Waiting..." 
                       FontSize="11"
                       TextColor="{AppThemeBinding Light=DarkBlue, Dark=LightSkyBlue}"/>
                <Button Text="Execute 'Edit' Command" 
                        Clicked="OnExecuteEditClicked"/>
            </VerticalStackLayout>

            <!-- Secondary Actions -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Secondary Items"/>
                <Label StyleClass="h3"
                       Text="Start with one static secondary item."/>
                <Label x:Name="SecondaryLogLabel" 
                       Text="Waiting..." 
                       FontSize="11"
                       TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}"/>
                <Button Text="Execute 'Secondary' Command" 
                        Clicked="OnExecuteSecondaryClicked"/>
            </VerticalStackLayout>

            <!-- Dynamic Items Management -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Dynamic Items Management"/>
                <Label StyleClass="h3"
                       Text="Add/Remove items dynamically."/>

                <Label Text="Primary Items:" FontAttributes="Bold" FontSize="12"/>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Text="Add Primary" 
                            Clicked="OnAddPrimaryItemClicked" />
                    <Button Grid.Column="1" 
                            Text="Remove Primary" 
                            Clicked="OnRemovePrimaryItemClicked"/>
                </Grid>

                <Label Text="Secondary Items:" FontAttributes="Bold" FontSize="12" Margin="0,5,0,0"/>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Text="Add Secondary" 
                            Clicked="OnAddSecondaryItemClicked" />
                    <Button Grid.Column="1" 
                            Text="Remove Secondary" 
                            Clicked="OnRemoveSecondaryItemClicked"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Visibility & State -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Visibility &amp; State"/>
                <Label StyleClass="h3"
                       Text="Toggle state. Note: ToolbarItem has no IsVisible, so we simulate it by adding/removing."/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Text="Toggle IsEnabled" 
                            Clicked="OnToggleEditClicked"/>
                    <Button Grid.Column="1" 
                            Text="Toggle Visibility" 
                            Clicked="OnToggleEditVisibilityClicked"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Item Modifications -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Item Modifications"/>
                <Label StyleClass="h3"
                       Text="Modify properties like Text and Icon."/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                     <Button Text="Toggle Icon" 
                             Clicked="OnToggleIconClicked"/>
                     <Button Grid.Column="1"
                             Text="Rename 'TextOnly'" 
                             Clicked="OnUpdateTextOnlyClicked"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Priority & Order -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Priority &amp; Order"/>
                <Label StyleClass="h3"
                       Text="Modify Priority (sorting) and Order (Primary/Secondary)."/>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Text="Swap Priorities" 
                            Clicked="OnSwapPrioritiesClicked"/>
                    <Button Grid.Column="1" 
                            Text="Toggle 'Edit' Order" 
                            Clicked="OnToggleEditOrderClicked"/>
                </Grid>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

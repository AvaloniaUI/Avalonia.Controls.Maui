<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.PopupsPage"
             Title="Popups">

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Shows alerts, action sheets, prompts and a busy indicator." />

            <Label x:Name="ResultLabel"
                   Text="Tap a sample to see the result here."
                   TextColor="{DynamicResource SecondaryTextColor}"
                   HorizontalOptions="Center" />

            <!-- Alerts Section -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Alerts" />
                <Button Text="Simple alert"
                        Clicked="OnSimpleAlertClicked" />
                <Button Text="Question (Yes/No)"
                        Clicked="OnAlertYesNoClicked" />
            </VerticalStackLayout>

            <!-- Action Sheets Section -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Action Sheets" />
                <Button Text="Share options"
                        Clicked="OnSimpleActionSheetClicked" />
                <Button Text="Save or delete (destructive)"
                        Clicked="OnActionSheetCancelDeleteClicked" />
            </VerticalStackLayout>

            <!-- Prompts Section -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Prompts" />
                <Button Text="Enter your name"
                        Clicked="OnSimplePromptClicked" />
                <Button Text="Enter a number (default 10)"
                        Clicked="OnNumberPromptClicked" />
            </VerticalStackLayout>

            <!-- Busy Indicator Section -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Busy Indicator" />
                <Button Text="Show busy (2 seconds)"
                        Clicked="OnShowBusyClicked" />
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

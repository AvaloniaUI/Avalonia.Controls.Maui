<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="ControlGallery.Pages.LifecycleEventsPage"
             x:DataType="pages:LifecycleEventsPage"
             Title="Lifecycle Events">
    <ContentPage.Resources>
        <Color x:Key="InheritedAccentColor">#2E7D32</Color>
    </ContentPage.Resources>

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Logs the events that an element raises when it changes." />

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Actions" />
                <Label StyleClass="h3"
                       Text="Add/remove, move, reorder, and update BindingContext." />
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button Text="Toggle Child" Clicked="OnToggleChildClicked" />
                    <Button Text="Move Child" Grid.Column="1" Clicked="OnMoveChildClicked" />
                    <Button Text="Reorder" Grid.Column="2" Clicked="OnReorderChildrenClicked" />
                    <Button Text="BindingContext" Grid.Row="1" Clicked="OnBindingContextClicked" />
                    <Button Text="Clear Log" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Clicked="OnClearLogClicked" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Focus" />
                <Label StyleClass="h3"
                       Text="Focus/Unfocus the Entry to raise Focused/Unfocused." />
                <HorizontalStackLayout Spacing="8">
                    <Entry x:Name="FocusEntry" Placeholder="Tap or focus me" WidthRequest="200" />
                    <Button Text="Focus" Clicked="OnFocusEntryClicked" />
                    <Button Text="Unfocus" Clicked="OnUnfocusEntryClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Size" />
                <Label StyleClass="h3"
                       Text="Adjust the tracked element to raise SizeChanged." />
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Width" WidthRequest="60" />
                        <Slider x:Name="WidthSlider"
                                Minimum="80"
                                Maximum="300"
                                ValueChanged="OnSizeSliderChanged" />
                        <Label x:Name="WidthValueLabel" WidthRequest="50" HorizontalTextAlignment="End" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Height" WidthRequest="60" />
                        <Slider x:Name="HeightSlider"
                                Minimum="40"
                                Maximum="200"
                                ValueChanged="OnSizeSliderChanged" />
                        <Label x:Name="HeightValueLabel" WidthRequest="50" HorizontalTextAlignment="End" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Parents" />
                <Label StyleClass="h3"
                       Text="Move the tracked element between parents to raise parent/child events." />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Stroke="Gray" Padding="8" BackgroundColor="#FFF6F6F6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout x:Name="ParentA" Spacing="6">
                            <Label Text="Parent A" FontAttributes="Bold" />
                            <Border x:Name="TrackedBorder"
                                    Stroke="DarkGray"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFEFEFEF"
                                    Padding="8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Label Text="Tracked Element" />
                            </Border>
                            <BoxView x:Name="SiblingBoxA" Color="#FFDDDDDD" HeightRequest="20" WidthRequest="80" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Stroke="Gray" Padding="8" BackgroundColor="#FFF6F6F6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout x:Name="ParentB" Spacing="6">
                            <Label Text="Parent B" FontAttributes="Bold" />
                            <BoxView x:Name="SiblingBoxB" Color="#FFDDDDDD" HeightRequest="20" WidthRequest="80" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Inherited properties" />
                <Grid ColumnDefinitions="140,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="6">
                    <Label Text="BindingContext" />
                    <Label x:Name="BindingContextValueLabel"
                           Grid.Column="1"
                           TextColor="{StaticResource InheritedAccentColor}" />

                    <Label Grid.Row="1" Text="Bounds" />
                    <Label x:Name="BoundsValueLabel" Grid.Row="1" Grid.Column="1" />

                    <Label Grid.Row="2" Text="Frame" />
                    <Label x:Name="FrameValueLabel" Grid.Row="2" Grid.Column="1" />

                    <Label Grid.Row="3" Text="Parent" />
                    <Label x:Name="ParentValueLabel" Grid.Row="3" Grid.Column="1" />

                    <Label Grid.Row="4" Text="Resources" />
                    <Label x:Name="ResourcesValueLabel"
                           Grid.Row="4"
                           Grid.Column="1"
                           TextColor="{StaticResource InheritedAccentColor}" />

                    <Label Grid.Row="5" Text="Window" />
                    <Label x:Name="WindowValueLabel" Grid.Row="5" Grid.Column="1" />

                    <Label Grid.Row="6" Text="X / Y" />
                    <Label x:Name="PositionValueLabel" Grid.Row="6" Grid.Column="1" />

                    <Label Grid.Row="7" Text="Effects" />
                    <Label x:Name="EffectsValueLabel" Grid.Row="7" Grid.Column="1" />

                    <Button Grid.Row="8"
                            Grid.ColumnSpan="2"
                            Text="Toggle Effect"
                            Clicked="OnToggleEffectClicked" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Event Log" />
                <CollectionView ItemsSource="{Binding EventLog}" HeightRequest="220">
                    <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <Label Text="{Binding .}" FontSize="12" />
                    </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

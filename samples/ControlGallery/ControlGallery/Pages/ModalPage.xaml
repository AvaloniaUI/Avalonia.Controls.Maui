<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.ModalPage"
             Title="Modal Pages">

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Modal pages are presented over the current page and require dismissal before returning. They use PushModalAsync / PopModalAsync."/>

            <Label x:Name="ResultLabel"
                   Text="Tap a button to present a modal page."
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- Basic Modal -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic Modal"/>
                <Label StyleClass="h3"
                       Text="Present a simple modal page that can be dismissed with a button."/>
                <Button Text="Show Basic Modal"
                        Clicked="OnShowBasicModal"/>
            </VerticalStackLayout>

            <!-- Modal with Result -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Modal with Result"/>
                <Label StyleClass="h3"
                       Text="Present a modal that returns a value when dismissed."/>
                <Button Text="Show Color Picker Modal"
                        Clicked="OnShowColorPickerModal"/>
            </VerticalStackLayout>

            <!-- Modal with Navigation -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Modal with NavigationPage"/>
                <Label StyleClass="h3"
                       Text="Wrap a modal in a NavigationPage to get a navigation bar and support pushing pages within the modal."/>
                <Button Text="Show Modal with Navigation"
                        Clicked="OnShowModalWithNavigation"/>
            </VerticalStackLayout>

            <!-- Full-Screen Modal -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Full-Screen Content"/>
                <Label StyleClass="h3"
                       Text="Present a modal with full-screen content (e.g. an image viewer)."/>
                <Button Text="Show Full-Screen Modal"
                        Clicked="OnShowFullScreenModal"/>
            </VerticalStackLayout>

            <!-- Modal Stack Info -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Modal Stack Info"/>
                <Label x:Name="ModalStackInfoLabel"
                       Text="Modal stack depth: 0"
                       FontSize="12"/>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.ScreenshotPage"
             Title="Screenshot">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Captures an image of the app window." />

            <!-- Capture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Window Screenshot" />
                <Label x:Name="SupportedLabel"
                       Text="IsCaptureSupported: --"/>
                <Button Text="Capture Screenshot"
                        Clicked="OnCaptureClicked"/>
                <Label x:Name="DimensionsLabel"
                       Text="Dimensions: --"
                       FontAttributes="Italic"/>
                <Image x:Name="ScreenshotImage"
                       HeightRequest="300"
                       Aspect="AspectFit"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

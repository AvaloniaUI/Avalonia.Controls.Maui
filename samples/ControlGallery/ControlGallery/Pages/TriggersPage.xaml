<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:local="clr-namespace:ControlGallery.Triggers"
             x:Class="ControlGallery.Pages.TriggersPage"
             Title="Triggers">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Changes a control's appearance with property, data, event and multi triggers." />

            <!-- Property Trigger -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Property Trigger" />
                <Label StyleClass="h3"
                       Text="The Entry background changes when you type 'Green'." />
                
                <Entry Placeholder="Type 'Green'">
                    <Entry.Triggers>
                        <Trigger TargetType="Entry" Property="Text" Value="Green">
                            <Setter Property="BackgroundColor" Value="#CCFFCC" />
                            <Setter Property="TextColor" Value="DarkGreen" />
                        </Trigger>
                    </Entry.Triggers>
                </Entry>
            </VerticalStackLayout>

            <!-- Data Trigger -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Data Trigger" />
                <Label StyleClass="h3"
                       Text="Button is enabled only when CheckBox is checked." />
                
                <CheckBox x:Name="EnableCheckBox" />
                <Label Text="Check to enable button" 
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                <Button Text="Save" IsEnabled="False" >
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference EnableCheckBox}, Path=IsChecked, x:DataType=CheckBox}" Value="True">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>

            <!-- Event Trigger -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Event Trigger" />
                <Label StyleClass="h3"
                       Text="Clicking the button triggers a Fade animation." />
                
                <Button Text="Click to Fade">
                    <Button.Triggers>
                        <EventTrigger Event="Clicked">
                            <local:FadeTriggerAction StartsFrom="1" />
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
            
            <!-- Multi Trigger -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Multi Trigger" />
                <Label StyleClass="h3"
                       Text="Entry turns orange ONLY when CheckBox is checked AND text is '123'." />
                
                <CheckBox x:Name="MultiTriggerCheckBox" />
                <Label Text="Check enabling condition" 
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                <Entry Placeholder="Type '123'">
                    <Entry.Triggers>
                        <MultiTrigger TargetType="Entry">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding Source={x:Reference MultiTriggerCheckBox}, Path=IsChecked, x:DataType=CheckBox}" Value="True" />
                                <PropertyCondition Property="Text" Value="123" />
                            </MultiTrigger.Conditions>
                            <Setter Property="TextColor" Value="DarkOrange" />
                            <Setter Property="BackgroundColor" Value="#FFE0B2" />
                        </MultiTrigger>
                    </Entry.Triggers>
                </Entry>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.IndicatorViewPage"
             x:DataType="pages:IndicatorViewPage"
             Title="IndicatorView">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Shows a row of indicators that represent the items in a CarouselView and the current position."/>

            <!-- Basic IndicatorView with CarouselView -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic IndicatorView with CarouselView"/>
                <CarouselView IndicatorView="basicIndicator"
                              HeightRequest="120"
                              ItemsSource="{Binding Items}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="pages:CarouselItem">
                            <Grid Margin="10">
                                <BoxView Color="{Binding Color}"
                                         CornerRadius="8"/>
                                <Label Text="{Binding Title}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="basicIndicator"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="DarkSlateBlue"/>
            </VerticalStackLayout>

            <!-- Custom Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Custom Colors"/>
                <CarouselView IndicatorView="colorIndicator"
                              HeightRequest="120"
                              ItemsSource="{Binding Items}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="pages:CarouselItem">
                            <Grid Margin="10">
                                <BoxView Color="{Binding Color}"
                                         CornerRadius="8"/>
                                <Label Text="{Binding Title}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="colorIndicator"
                               HorizontalOptions="Center"
                               IndicatorColor="Orange"
                               SelectedIndicatorColor="DarkOrange"/>
            </VerticalStackLayout>

            <!-- Pre-selected Position -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pre-selected Position (starts at index 2)"/>
                <CarouselView x:Name="preselectedCarousel"
                              IndicatorView="preselectedIndicator"
                              HeightRequest="120"
                              Position="2"
                              ItemsSource="{Binding Items}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="pages:CarouselItem">
                            <Grid Margin="10">
                                <BoxView Color="{Binding Color}"
                                         CornerRadius="8"/>
                                <Label Text="{Binding Title}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="preselectedIndicator"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="DeepSkyBlue"
                               IndicatorSize="10"/>
            </VerticalStackLayout>

            <!-- Custom Indicator Size -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Custom Indicator Sizes"/>
                <Label Text="Small (6)"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="{Binding Count}"
                               Position="{Binding Position}"
                               IndicatorSize="6"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="DodgerBlue"
                               Margin="0,4"/>
                <Label Text="Medium (12)"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="{Binding Count}"
                               Position="{Binding Position}"
                               IndicatorSize="12"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="DodgerBlue"
                               Margin="0,4"/>
                <Label Text="Large (20)"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="{Binding Count}"
                               Position="{Binding Position}"
                               IndicatorSize="20"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="DodgerBlue"
                               Margin="0,8"/>
            </VerticalStackLayout>

            <!-- Indicator Shapes -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Indicator Shapes"/>
                <Label Text="Circle (default)"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="5"
                               Position="2"
                               IndicatorsShape="Circle"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="CornflowerBlue"
                               Margin="0,4"/>
                <Label Text="Rectangle"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="5"
                               Position="2"
                               IndicatorsShape="Square"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="CornflowerBlue"
                               Margin="0,4"/>
            </VerticalStackLayout>

            <!-- MaximumVisible -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="MaximumVisible = 3 (of 5 total)"/>
                <IndicatorView Count="5"
                               Position="0"
                               MaximumVisible="3"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="CornflowerBlue"/>
            </VerticalStackLayout>

            <!-- HideSingle -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="HideSingle = true (hidden when Count = 1)"/>
                <Label Text="The indicator below is hidden because Count = 1:"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="1"
                               HideSingle="True"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="Black"/>
                <Label Text="(nothing visible above — correct!)"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
                <Label Text="Count = 3 with HideSingle = true (visible):"
                       FontSize="12"
                       TextColor="Gray"/>
                <IndicatorView Count="3"
                               HideSingle="True"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="Black"/>
            </VerticalStackLayout>

            <!-- Custom Numbered Indicator via IndicatorTemplate -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Custom Numbered Indicator (IndicatorTemplate)"/>
                <Label StyleClass="h3"
                       Text="Each pip is rendered from a custom DataTemplate"/>
                <CarouselView IndicatorView="numberedIndicator"
                              HeightRequest="120"
                              ItemsSource="{Binding Items}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="pages:CarouselItem">
                            <Grid Margin="10">
                                <BoxView Color="{Binding Color}"
                                         CornerRadius="8"/>
                                <Label Text="{Binding Title}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <IndicatorView x:Name="numberedIndicator"
                               HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Programmatic Control -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Programmatic Control"/>
                <IndicatorView Count="{Binding Count}"
                               Position="{Binding Position}"
                               HorizontalOptions="Center"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="MediumPurple"/>
                <Label Text="{Binding PositionText}"
                       HorizontalOptions="Center"
                       FontSize="12"
                       TextColor="Gray"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Button Text="Previous"
                            Command="{Binding PreviousCommand}"/>
                    <Button Text="Next"
                            Command="{Binding NextCommand}"/>
                    <Button Text="Reset"
                            Command="{Binding ResetCommand}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

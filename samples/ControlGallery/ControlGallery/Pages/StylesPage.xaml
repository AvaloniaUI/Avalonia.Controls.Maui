<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.StylesPage"
             Title="Styles">
    <ContentPage.Resources>
        <!-- Implicit Style for Entry (Applied automatically) -->
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="Purple" />
            <Setter Property="PlaceholderColor" Value="#E0B0FF" />
        </Style>

        <!-- Explicit Style -->
        <Style x:Key="ExplicitButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Orange" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Inherited Style (BasedOn) -->
        <Style x:Key="BaseLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="Gray" />
        </Style>
        
        <Style x:Key="DerivedLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
            <Setter Property="FontAttributes" Value="Italic" />
            <Setter Property="TextColor" Value="Blue" /> <!-- Overrides base -->
        </Style>

        <!-- Style Classes -->
        <Style TargetType="Button" Class="Warning">
            <Setter Property="BackgroundColor" Value="#FFCC00" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
        
        <Style TargetType="Button" Class="Danger">
            <Setter Property="BackgroundColor" Value="#FF0000" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Applies implicit, explicit, inherited and class-based styles to controls." />

            <!-- Implicit Styles -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Implicit Styles" />
                <Label StyleClass="h3"
                       Text="This Entry has no Style property set, but picks up the implicit style defined in the page resources (Purple text)." />
                
                <Entry Placeholder="I am implicitly styled!" Text="Purple Text" />
            </VerticalStackLayout>

            <!-- Explicit Styles -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Explicit Styles" />
                <Label StyleClass="h3"
                       Text="This Button uses a specific style key." />
                
                <Button Text="Explicit Style" Style="{StaticResource ExplicitButtonStyle}" />
            </VerticalStackLayout>

            <!-- Style Inheritance -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Style Inheritance" />
                <Label StyleClass="h3"
                       Text="The second label inherits from the first but changes color and adds italics." />
                
                <Label Text="Base Style (Gray, 16)" Style="{StaticResource BaseLabelStyle}" />
                <Label Text="Derived Style (Blue, 16, Italic)" Style="{StaticResource DerivedLabelStyle}" />
            </VerticalStackLayout>
            
            <!-- Style Classes -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Style Classes" />
                <Label StyleClass="h3"
                       Text="Apply styles by class name, allowing multiple controls to share styling logic independently of their key." />
                
                <Button Text="Warning Class" StyleClass="Warning" />
                <Button Text="Danger Class" StyleClass="Danger" />
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>
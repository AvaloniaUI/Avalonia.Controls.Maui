<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.LinePage"
             Title="Line">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Draws a straight line between two points." />

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Simple Lines" />
                <Grid HeightRequest="120"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="16">
                    <Line X1="0"
                          Y1="60"
                          X2="120"
                          Y2="60"
                          Stroke="#2563EB"
                          StrokeThickness="4" />
                    <Line Grid.Column="1"
                          X1="0"
                          Y1="10"
                          X2="120"
                          Y2="110"
                          Stroke="#10B981"
                          StrokeThickness="4"
                          StrokeDashArray="8,4" />
                    <Line Grid.Column="2"
                          X1="60"
                          Y1="0"
                          X2="60"
                          Y2="120"
                          Stroke="#EF4444"
                          StrokeThickness="6"
                          StrokeLineCap="Round" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Line Caps" />
                <VerticalStackLayout Spacing="8">
                    <Line X1="10" Y1="0" X2="210" Y2="0"
                          Stroke="#2563EB"
                          StrokeThickness="12"
                          StrokeLineCap="Flat" />
                    <Line X1="10" Y1="0" X2="210" Y2="0"
                          Stroke="#10B981"
                          StrokeThickness="12"
                          StrokeLineCap="Round" />
                    <Line X1="10" Y1="0" X2="210" Y2="0"
                          Stroke="#F59E0B"
                          StrokeThickness="12"
                          StrokeLineCap="Square" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

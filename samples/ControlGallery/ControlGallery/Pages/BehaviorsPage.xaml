<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:local="clr-namespace:ControlGallery.Behaviors"
             x:Class="ControlGallery.Pages.BehaviorsPage"
             Title="Behaviors">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Attaches behaviors that add validation and formatting to Entry controls." />

            <!-- Numeric Validation Behavior -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Numeric Validation Behavior" />
                <Label StyleClass="h3"
                       Text="Enter a number (Standard Behavior). Text turns red if invalid." />
                
                <Entry Placeholder="Enter a number" Keyboard="Numeric">
                    <Entry.Behaviors>
                        <local:NumericValidationBehavior />
                    </Entry.Behaviors>
                </Entry>
            </VerticalStackLayout>

            <!-- Email Validation Behavior -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Email Validation Behavior" />
                <Label StyleClass="h3"
                       Text="Enter an email address. Text turns red if invalid format." />
                
                <Entry Placeholder="Enter email address" Keyboard="Email">
                    <Entry.Behaviors>
                        <local:EmailValidationBehavior />
                    </Entry.Behaviors>
                </Entry>
            </VerticalStackLayout>

            <!-- Upper Case Behavior -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Upper Case Behavior" />
                <Label StyleClass="h3"
                       Text="Type below. Text will automatically convert to uppercase." />
                
                <Entry Placeholder="Type text here" >
                    <Entry.Behaviors>
                        <local:UpperCaseBehavior />
                    </Entry.Behaviors>
                </Entry>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>

</ContentPage>

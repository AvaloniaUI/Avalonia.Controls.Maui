<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:effects="clr-namespace:ControlGallery.Effects"
             x:Class="ControlGallery.Pages.EffectsPage"
             Title="Effects">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Applies a platform effect to a control."/>

            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Focus Effect"/>
                <Label StyleClass="h3"
                       Text="Focus the entry to let the PlatformEffect update its native background."/>

                <Entry x:Name="FocusEffectEntry"
                       Text="Focus me"
                       Placeholder="Focus background effect">
                    <Entry.Effects>
                        <effects:FocusRoutingEffect />
                    </Entry.Effects>
                </Entry>

                <Label x:Name="EffectStatusLabel"
                       FontSize="13"
                       TextColor="Gray"/>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             x:Class="ControlGallery.Pages.ImageButtonPage"
             x:DataType="pages:ImageButtonPage"
             Title="ImageButton">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="A button that displays an image and runs an action when clicked."/>

            <!-- Basic ImageButtons -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic ImageButtons"/>
                <ImageButton Source="dotnet_bot.png"
                             WidthRequest="100"
                             HeightRequest="100"
                             Clicked="OnImageButtonClicked"
                             HorizontalOptions="Center"/>
                <ImageButton Source="dotnet_bot.png"
                             WidthRequest="80"
                             HeightRequest="80"
                             IsEnabled="False"
                             HorizontalOptions="Center"/>
                <Label Text="Disabled ImageButton above"
                       FontSize="12"
                       FontAttributes="Italic"
                       HorizontalOptions="Center"/>
                <Label x:Name="ImageButtonClickCountLabel"
                       Text="ImageButton click count: 0"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- ImageButton Aspect Modes -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Aspect Modes"/>
                <Label StyleClass="h3"
                       Text="Each ImageButton is 120x80 to show aspect differences:"/>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="120"
                                     HeightRequest="80"
                                     Aspect="AspectFit"
                                     BackgroundColor="LightGray"/>
                        <Label Text="AspectFit"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="120"
                                     HeightRequest="80"
                                     Aspect="AspectFill"
                                     BackgroundColor="LightGray"/>
                        <Label Text="AspectFill"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="120"
                                     HeightRequest="80"
                                     Aspect="Fill"
                                     BackgroundColor="LightGray"/>
                        <Label Text="Fill"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="120"
                                     HeightRequest="80"
                                     Aspect="Center"
                                     BackgroundColor="LightGray"/>
                        <Label Text="Center"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- ImageButton Borders and CornerRadius -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Borders and Corner Radius"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     BorderColor="Red"
                                     BorderWidth="3"
                                     CornerRadius="0"/>
                        <Label Text="Square"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     BorderColor="Blue"
                                     BorderWidth="3"
                                     CornerRadius="10"/>
                        <Label Text="Rounded"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     BorderColor="Green"
                                     BorderWidth="3"
                                     CornerRadius="40"/>
                        <Label Text="Circle"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label Text="Border Width Variations:"
                       FontSize="12"
                       Margin="0,10,0,0"/>
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="60"
                                 HeightRequest="60"
                                 BorderColor="Purple"
                                 BorderWidth="1"/>
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="60"
                                 HeightRequest="60"
                                 BorderColor="Purple"
                                 BorderWidth="3"/>
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="60"
                                 HeightRequest="60"
                                 BorderColor="Purple"
                                 BorderWidth="5"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- ImageButton Padding -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Padding"/>
                <Label StyleClass="h3"
                       Text="Each button has the same image but different padding:"/>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     Padding="0"
                                     BackgroundColor="LightBlue"
                                     BorderColor="DarkBlue"
                                     BorderWidth="1"/>
                        <Label Text="Padding=0"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     Padding="10"
                                     BackgroundColor="LightBlue"
                                     BorderColor="DarkBlue"
                                     BorderWidth="1"/>
                        <Label Text="Padding=10"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     Padding="20"
                                     BackgroundColor="LightBlue"
                                     BorderColor="DarkBlue"
                                     BorderWidth="1"/>
                        <Label Text="Padding=20"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- ImageButton Background Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Background Colors"/>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="70"
                                 HeightRequest="70"
                                 BackgroundColor="LightCoral"
                                 Padding="5"
                                 CornerRadius="8"/>
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="70"
                                 HeightRequest="70"
                                 BackgroundColor="LightGreen"
                                 Padding="5"
                                 CornerRadius="8"/>
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="70"
                                 HeightRequest="70"
                                 BackgroundColor="LightBlue"
                                 Padding="5"
                                 CornerRadius="8"/>
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="70"
                                 HeightRequest="70"
                                 BackgroundColor="Gold"
                                 Padding="5"
                                 CornerRadius="8"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- ImageButton Command and CommandParameter -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Command and CommandParameter"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="70"
                                     HeightRequest="70"
                                     Command="{Binding ImageButtonCommand}"
                                     BackgroundColor="LightGray"
                                     CornerRadius="10"/>
                        <Label Text="Simple Command"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="70"
                                     HeightRequest="70"
                                     Command="{Binding ImageButtonParameterizedCommand}"
                                     CommandParameter="Image1"
                                     BackgroundColor="LightGreen"
                                     CornerRadius="10"/>
                        <Label Text="Param: Image1"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="70"
                                     HeightRequest="70"
                                     Command="{Binding ImageButtonParameterizedCommand}"
                                     CommandParameter="Image2"
                                     BackgroundColor="LightBlue"
                                     CornerRadius="10"/>
                        <Label Text="Param: Image2"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Label x:Name="ImageButtonCommandResultLabel"
                       Text="No ImageButton command executed yet"
                       HorizontalOptions="Center"
                       FontAttributes="Italic"/>
            </VerticalStackLayout>

            <!-- ImageButton Pressed and Released Events -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pressed and Released Events"/>
                <Label StyleClass="h3"
                       Text="Press and hold to see visual feedback:"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="80"
                                 HeightRequest="80"
                                 BackgroundColor="LightBlue"
                                 CornerRadius="10"
                                 BorderColor="DarkBlue"
                                 BorderWidth="2"
                                 Pressed="OnImageButton1Pressed"
                                 Released="OnImageButton1Released"/>

                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="80"
                                 HeightRequest="80"
                                 BackgroundColor="LightGreen"
                                 CornerRadius="40"
                                 BorderColor="DarkGreen"
                                 BorderWidth="2"
                                 Pressed="OnImageButton2Pressed"
                                 Released="OnImageButton2Released"/>

                    <ImageButton Source="dotnet_bot.png"
                                 WidthRequest="80"
                                 HeightRequest="80"
                                 BackgroundColor="LightCoral"
                                 CornerRadius="10"
                                 BorderColor="DarkRed"
                                 BorderWidth="2"
                                 Pressed="OnImageButton3Pressed"
                                 Released="OnImageButton3Released"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Styled ImageButtons -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Styled ImageButton Examples"/>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <!-- Social Media Style -->
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="50"
                                     HeightRequest="50"
                                     BackgroundColor="#1DA1F2"
                                     CornerRadius="25"
                                     Padding="10"/>
                        <Label Text="Social"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Floating Action Button Style -->
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="60"
                                     HeightRequest="60"
                                     BackgroundColor="#FF5722"
                                     CornerRadius="30"
                                     Padding="12"/>
                        <Label Text="FAB"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Card Action Style -->
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="100"
                                     HeightRequest="60"
                                     BackgroundColor="White"
                                     BorderColor="Gray"
                                     BorderWidth="1"
                                     CornerRadius="8"
                                     Padding="10"/>
                        <Label Text="Card Action"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10,0,0">
                    <!-- Icon Button Style -->
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="40"
                                     HeightRequest="40"
                                     BackgroundColor="Transparent"
                                     Padding="5"/>
                        <Label Text="Icon"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Badge Style -->
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="70"
                                     HeightRequest="70"
                                     BackgroundColor="White"
                                     BorderColor="#6200EE"
                                     BorderWidth="3"
                                     CornerRadius="35"
                                     Padding="8"/>
                        <Label Text="Badge"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Thumbnail Style -->
                    <VerticalStackLayout>
                        <ImageButton Source="dotnet_bot.png"
                                     WidthRequest="80"
                                     HeightRequest="80"
                                     Aspect="AspectFill"
                                     CornerRadius="8"/>
                        <Label Text="Thumbnail"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>

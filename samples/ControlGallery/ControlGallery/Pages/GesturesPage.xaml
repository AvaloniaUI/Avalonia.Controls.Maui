<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.GesturesPage"
             Title="Gestures">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Responds to taps, pans, pinches, swipes and pointer input through gesture recognizers." />

            <!-- Single Tap -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Single Tap" />
                <Label StyleClass="h3"
                       Text="TapGestureRecognizer with NumberOfTapsRequired=&quot;1&quot;" />

                <Border x:Name="SingleTapBox" 
                        HeightRequest="150" 
                        StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="LightBlue">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSingleTapTapped" NumberOfTapsRequired="1" />
                    </Border.GestureRecognizers>
                    <Label x:Name="SingleTapLabel" 
                           Text="Tap me!" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" 
                           FontAttributes="Bold"/>
                </Border>
                <Label x:Name="SingleTapCountLabel" Text="Taps: 0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Double Tap -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Double Tap" />
                <Label StyleClass="h3"
                       Text="TapGestureRecognizer with NumberOfTapsRequired=&quot;2&quot;" />

                <Border x:Name="DoubleTapBox" 
                        HeightRequest="150" 
                        StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="LightCoral">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDoubleTapTapped" NumberOfTapsRequired="2" />
                    </Border.GestureRecognizers>
                    <Label x:Name="DoubleTapLabel" 
                           Text="Double tap me!" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" 
                           FontAttributes="Bold"/>
                </Border>
                <Label x:Name="DoubleTapCountLabel" Text="Double Taps: 0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Pan Gesture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pan Gesture" />
                <Label StyleClass="h3"
                       Text="PanGestureRecognizer - drag the box around" />

                <Border HeightRequest="200" 
                        StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="#F0F0F0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <AbsoluteLayout>
                        <Border x:Name="PanBox" 
                                HeightRequest="60" 
                                WidthRequest="60"
                                StrokeThickness="0"
                                BackgroundColor="MediumPurple"
                                AbsoluteLayout.LayoutBounds="0.5,0.5,60,60"
                                AbsoluteLayout.LayoutFlags="PositionProportional">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                            </Border.GestureRecognizers>
                            <Label Text="Drag me" 
                                   FontSize="10"
                                   TextColor="White"
                                   VerticalOptions="Center" 
                                   HorizontalOptions="Center"/>
                        </Border>
                    </AbsoluteLayout>
                </Border>
                <Label x:Name="PanStatusLabel" Text="Pan: Idle" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Pointer Gesture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pointer Gesture" />
                <Label StyleClass="h3"
                       Text="PointerGestureRecognizer - Hover, Press, Move" />

                <Border x:Name="PointerBox" 
                        HeightRequest="150" 
                        StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="LightGoldenrodYellow">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered"
                                                  PointerExited="OnPointerExited"
                                                  PointerMoved="OnPointerMoved"
                                                  PointerPressed="OnPointerPressed"
                                                  PointerReleased="OnPointerReleased"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="PointerLabel" 
                           Text="Hover/Click me!" 
                           TextColor="Black"
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" 
                           FontAttributes="Bold"/>
                </Border>
                <Label x:Name="PointerStatusLabel" Text="Status: Idle" HorizontalOptions="Center" />
                <Label x:Name="PointerPositionLabel" Text="Position: -" HorizontalOptions="Center" FontSize="12" />
            </VerticalStackLayout>
            
            <!-- Swipe Gesture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Swipe Gesture" />
                <Label StyleClass="h3"
                       Text="SwipeGestureRecognizer (Left, Right, Up, Down)" />

                <Border x:Name="SwipeBox" 
                        HeightRequest="150" 
                        StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="LightCyan">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Left" Swiped="OnSwiped" />
                        <SwipeGestureRecognizer Direction="Right" Swiped="OnSwiped" />
                        <SwipeGestureRecognizer Direction="Up" Swiped="OnSwiped" />
                        <SwipeGestureRecognizer Direction="Down" Swiped="OnSwiped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="SwipeLabel" 
                           Text="Swipe me!" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" 
                           TextColor="Black"
                           FontAttributes="Bold"/>
                </Border>
                <Label x:Name="SwipeStatusLabel" Text="Last Swipe: None" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Pinch Gesture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Pinch Gesture" />
                <Label StyleClass="h3"
                       Text="PinchGestureRecognizer - pinch to scale the box (use touch)" />

                <Border HeightRequest="200"
                        StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="#F0F0F0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                        <Border x:Name="PinchBox"
                                HeightRequest="80"
                                WidthRequest="80"
                                StrokeThickness="0"
                                BackgroundColor="Teal"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                            </Border.GestureRecognizers>
                            <Label Text="Pinch me"
                                   FontSize="10"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Label x:Name="PinchStatusLabel" Text="Pinch: Idle" HorizontalOptions="Center" />
                <Label x:Name="PinchScaleLabel" Text="Scale: 1.0x" HorizontalOptions="Center" FontSize="12" />
            </VerticalStackLayout>

            <!-- Grid Tap Gesture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Grid Tap Gesture" />
                <Label StyleClass="h3"
                       Text="TapGestureRecognizer on a Grid layout" />

                <Grid x:Name="TapGrid"
                      HeightRequest="150"
                      BackgroundColor="LightSteelBlue"
                      ColumnDefinitions="*,*"
                      Padding="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGridTapTapped" NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <Label Text="Left"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"/>
                    <Label Text="Right"
                           Grid.Column="1"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"/>
                </Grid>
                <Label x:Name="GridTapCountLabel" Text="Grid Taps: 0" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Grid Pointer Gesture -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Grid Pointer Gesture" />
                <Label StyleClass="h3"
                       Text="PointerGestureRecognizer on a Grid with multiple cells" />

                <Grid x:Name="PointerGrid"
                      HeightRequest="150"
                      BackgroundColor="Lavender"
                      RowDefinitions="*,*"
                      ColumnDefinitions="*,*"
                      RowSpacing="2"
                      ColumnSpacing="2">
                    <Grid.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnGridPointerEntered"
                                                  PointerExited="OnGridPointerExited"
                                                  PointerMoved="OnGridPointerMoved" />
                    </Grid.GestureRecognizers>
                    <BoxView Color="CornflowerBlue" Grid.Row="0" Grid.Column="0" />
                    <BoxView Color="MediumSeaGreen" Grid.Row="0" Grid.Column="1" />
                    <BoxView Color="Coral" Grid.Row="1" Grid.Column="0" />
                    <BoxView Color="MediumPurple" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <Label x:Name="GridPointerStatusLabel" Text="Grid Pointer: Idle" HorizontalOptions="Center" />
                <Label x:Name="GridPointerPositionLabel" Text="Position: -" HorizontalOptions="Center" FontSize="12" />
            </VerticalStackLayout>

            <!-- Grid Multiple Gestures -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Grid Multiple Gestures" />
                <Label StyleClass="h3"
                       Text="Tap + Pointer + Swipe on the same Grid" />

                <Grid x:Name="MultiGestureGrid"
                      HeightRequest="150"
                      BackgroundColor="MistyRose"
                      Padding="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMultiGridTapped" NumberOfTapsRequired="1" />
                        <PointerGestureRecognizer PointerEntered="OnMultiGridPointerEntered"
                                                  PointerExited="OnMultiGridPointerExited" />
                        <SwipeGestureRecognizer Direction="Left" Swiped="OnMultiGridSwiped" />
                        <SwipeGestureRecognizer Direction="Right" Swiped="OnMultiGridSwiped" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="MultiGestureGridLabel"
                           Text="Tap, hover, or swipe!"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"/>
                </Grid>
                <Label x:Name="MultiGestureStatusLabel" Text="Last Event: None" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             x:Class="ControlGallery.Pages.SearchBarPage"
             x:DataType="pages:SearchBarPage"
             Title="SearchBar">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="A text box for entering and starting a search."/>

            <!-- Basic SearchBar -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic SearchBar"/>
                <SearchBar Placeholder="Search something..."/>
            </VerticalStackLayout>

            <!-- SearchButtonPressed Event -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="SearchButtonPressed Event"/>
                <Label StyleClass="h3"
                       Text="Press Enter or tap search icon to trigger"/>
                <SearchBar x:Name="SearchEventBar"
                           Placeholder="Type and press Enter/Search"
                           SearchButtonPressed="OnSearchEventTriggered"/>
                <Label x:Name="SearchEventLabel"
                       Text="Waiting for search event..."
                       FontSize="Small"
                       TextColor="Gray"/>
            </VerticalStackLayout>

            <!-- SearchCommand -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="SearchCommand"/>
                <Label StyleClass="h3"
                       Text="Uses ICommand binding (MVVM pattern)"/>
                <SearchBar x:Name="CommandSearchBar"
                           Placeholder="Type and press Enter/Search"
                           SearchCommand="{Binding SearchCommand}"
                           SearchCommandParameter="MyParameter"/>
                <Label x:Name="CommandResultLabel"
                       Text="Command not executed yet..."
                       FontSize="Small"
                       TextColor="Gray"/>
            </VerticalStackLayout>

            <!-- Text Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Text Color"/>
                <SearchBar Placeholder="Type to see red text"
                           TextColor="Red"/>
                <SearchBar Placeholder="Type to see blue text"
                           TextColor="Blue"/>
                <SearchBar Placeholder="Type to see green text"
                           TextColor="Green"/>
            </VerticalStackLayout>

            <!-- Placeholder Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Placeholder Color"/>
                <SearchBar Placeholder="Coral placeholder"
                           PlaceholderColor="Coral"/>
                <SearchBar Placeholder="SkyBlue placeholder"
                           PlaceholderColor="SkyBlue"/>
                <SearchBar Placeholder="LimeGreen placeholder"
                           PlaceholderColor="LimeGreen"/>
            </VerticalStackLayout>

            <!-- Search Icon Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Search Icon Color"/>
                <Label StyleClass="h3"
                       Text="Customize the magnifying glass icon color (MauiSearchBar Attached Property)"/>
                <SearchBar Placeholder="Red search icon"
                           SearchIconColor="Red"/>
                <SearchBar Placeholder="Orange search icon"
                           SearchIconColor="Orange"/>
                <SearchBar Placeholder="Purple search icon"
                           SearchIconColor="Purple"/>
            </VerticalStackLayout>

            <!-- Cancel Button Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Cancel Button Colors"/>
                <SearchBar Placeholder="Type to see clear button"
                           Text="Red cancel button"
                           CancelButtonColor="Red"/>
                <SearchBar Placeholder="Type to see clear button"
                           Text="Purple cancel button"
                           CancelButtonColor="Purple"/>
                <SearchBar Placeholder="Type to see clear button"
                           Text="Orange cancel button"
                           CancelButtonColor="Orange"/>
            </VerticalStackLayout>

            <!-- Font Customization -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Font Customization"/>
                <SearchBar Placeholder="FontSize 12"
                           FontSize="12"/>
                <SearchBar Placeholder="FontSize 18"
                           FontSize="18"/>
                <SearchBar Placeholder="FontSize 24"
                           FontSize="24"/>
                <SearchBar Placeholder="Bold text"
                           FontAttributes="Bold"
                           Text="Bold SearchBar"/>
                <SearchBar Placeholder="Italic text"
                           FontAttributes="Italic"
                           Text="Italic SearchBar"/>
                <SearchBar Placeholder="Courier New font"
                           FontFamily="Courier New"
                           Text="Monospace Font"/>
                <SearchBar Placeholder="Georgia font"
                           FontFamily="Georgia"
                           Text="Serif Font"/>
            </VerticalStackLayout>

            <!-- Character Spacing -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Character Spacing"/>
                <SearchBar Placeholder="No spacing (0)"
                           Text="Normal text"
                           CharacterSpacing="0"/>
                <SearchBar Placeholder="Spacing 2"
                           Text="Spaced text"
                           CharacterSpacing="2"/>
                <SearchBar Placeholder="Spacing 5"
                           Text="Wide spacing"
                           CharacterSpacing="5"/>
            </VerticalStackLayout>

            <!-- Selection Length -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Selection Length"/>
                <Label StyleClass="h3"
                       Text="Focus the SearchBar, then tap buttons to select text"/>
                <SearchBar x:Name="SelectionSearchBar"
                           Placeholder="Focus and use buttons below"
                           Text="Select this text"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Button Text="Select All"
                            Clicked="OnSelectAllClicked"/>
                    <Button Text="Select 5 chars"
                            Clicked="OnSelect5Clicked"/>
                    <Button Text="Clear Selection"
                            Clicked="OnClearSelectionClicked"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Horizontal Text Alignment -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Horizontal Text Alignment"/>
                <SearchBar Placeholder="Left aligned (Start)"
                           Text="Left aligned"
                           HorizontalTextAlignment="Start"/>
                <SearchBar Placeholder="Center aligned"
                           Text="Center aligned"
                           HorizontalTextAlignment="Center"/>
                <SearchBar Placeholder="Right aligned (End)"
                           Text="Right aligned"
                           HorizontalTextAlignment="End"/>
            </VerticalStackLayout>

            <!-- Vertical Text Alignment -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Vertical Text Alignment"/>
                <SearchBar Placeholder="Top aligned"
                           Text="Top aligned"
                           VerticalTextAlignment="Start"
                           HeightRequest="80"/>
                <SearchBar Placeholder="Center aligned"
                           Text="Center aligned"
                           VerticalTextAlignment="Center"
                           HeightRequest="80"/>
                <SearchBar Placeholder="Bottom aligned"
                           Text="Bottom aligned"
                           VerticalTextAlignment="End"
                           HeightRequest="80"/>
            </VerticalStackLayout>

            <!-- Read-Only Mode -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Read-Only Mode"/>
                <SearchBar Placeholder="This is read-only"
                           Text="Cannot edit this text"
                           IsReadOnly="True"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Switch IsToggled="{Binding IsReadOnly}"/>
                    <Label Text="{Binding IsReadOnly, StringFormat='IsReadOnly: {0}'}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <SearchBar Placeholder="Toggle read-only above"
                           Text="{Binding EditableText}"
                           IsReadOnly="{Binding IsReadOnly}"/>
            </VerticalStackLayout>

            <!-- Max Length -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Max Length"/>
                <SearchBar Placeholder="Max 10 characters"
                           MaxLength="10"/>
                <SearchBar Placeholder="Max 20 characters"
                           MaxLength="20"/>
                <SearchBar Placeholder="Max 5 characters"
                           MaxLength="5"/>
            </VerticalStackLayout>

            <!-- Cursor Position and Selection -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Cursor Position"/>
                <SearchBar x:Name="CursorSearchBar"
                           Placeholder="Focus to change cursor"
                           Text="Hello World Example"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <Button Text="Start"
                            Clicked="OnCursorStartClicked"/>
                    <Button Text="Middle"
                            Clicked="OnCursorMiddleClicked"/>
                    <Button Text="End"
                            Clicked="OnCursorEndClicked"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Event Handling -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Event Handling"/>
                <SearchBar Placeholder="Type to see TextChanged event"
                           TextChanged="OnTextChanged"
                           SearchButtonPressed="OnSearchButtonPressed"/>
                <Label Text="{Binding EventLog}"
                       TextColor="DarkGray"
                       FontSize="12"/>
                <Button Text="Clear Log"
                        Command="{Binding ClearLogCommand}"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

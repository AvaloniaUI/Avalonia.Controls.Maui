<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ControlGallery.Pages.RatingViewPage"
             Title="RatingView">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Shows a rating as a row of shapes, such as stars, that the user can tap." />

            <!-- Default -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Default" />
                <Label StyleClass="h3"
                       Text="Tap a shape to set the rating." />
                <toolkit:RatingView x:Name="DefaultRating"
                                    RatingChanged="OnDefaultRatingChanged"/>
                <Label x:Name="DefaultRatingLabel"
                       Text="Rating: 0"/>
            </VerticalStackLayout>

            <!-- Shapes and Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Shapes and Colors" />
                <Label StyleClass="h3"
                       Text="MaximumRating sets the number of shapes. FillColor and EmptyShapeColor color them." />
                <toolkit:RatingView Shape="Star"
                                    MaximumRating="10"
                                    Rating="7"
                                    FillColor="Gold"
                                    EmptyShapeColor="LightGray"/>
                <toolkit:RatingView Shape="Heart"
                                    Rating="3"
                                    FillColor="Red"
                                    EmptyShapeColor="Pink"/>
                <toolkit:RatingView Shape="Circle"
                                    Rating="4"
                                    FillColor="{AppThemeBinding Light=#6200EE, Dark=#03DAC5}"/>
                <toolkit:RatingView Shape="Like"
                                    MaximumRating="3"
                                    Rating="2"
                                    FillColor="Green"/>
                <toolkit:RatingView Shape="Dislike"
                                    MaximumRating="3"
                                    Rating="1"
                                    FillColor="OrangeRed"/>
            </VerticalStackLayout>

            <!-- Size and Spacing -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Size and Spacing" />
                <Label StyleClass="h3"
                       Text="ShapeDiameter sets the size of each shape. Spacing sets the gap between them." />
                <toolkit:RatingView Rating="2"
                                    ShapeDiameter="48"
                                    Spacing="12"/>
            </VerticalStackLayout>

            <!-- Read-Only -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Read-Only" />
                <Label StyleClass="h3"
                       Text="A read-only rating shows a value and ignores taps." />
                <toolkit:RatingView Rating="4"
                                    IsReadOnly="True"/>
            </VerticalStackLayout>

            <!-- Fractional Rating -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Fractional Rating" />
                <Label StyleClass="h3"
                       Text="A fractional rating fills part of a shape. FillOption fills the shape or the background behind it." />
                <toolkit:RatingView Rating="3.5"
                                    IsReadOnly="True"
                                    FillOption="Shape"/>
                <toolkit:RatingView Rating="3.5"
                                    IsReadOnly="True"
                                    FillOption="Background"/>
                <Slider x:Name="FractionalSlider"
                        Minimum="0"
                        Maximum="5"
                        Value="2.5"
                        ValueChanged="OnFractionalSliderChanged"/>
                <toolkit:RatingView x:Name="FractionalRating"
                                    Rating="2.5"
                                    IsReadOnly="True"/>
                <Label x:Name="FractionalRatingLabel"
                       Text="Rating: 2.5"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

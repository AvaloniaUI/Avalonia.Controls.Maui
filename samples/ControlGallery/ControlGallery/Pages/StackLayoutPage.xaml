<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.StackLayoutPage"
             Title="StackLayout">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="A layout that arranges its children in a single line, vertically or horizontally."/>

            <!-- Basic Vertical StackLayout -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic Vertical StackLayout"/>
                <Label Text="Primary colors"/>
                <BoxView Color="Red"
                         HeightRequest="40"/>
                <BoxView Color="Yellow"
                         HeightRequest="40"/>
                <BoxView Color="Blue"
                         HeightRequest="40"/>
                <Label Text="Secondary colors"/>
                <BoxView Color="Green"
                         HeightRequest="40"/>
                <BoxView Color="Orange"
                         HeightRequest="40"/>
                <BoxView Color="Purple"
                         HeightRequest="40"/>
            </VerticalStackLayout>

            <!-- Horizontal StackLayout -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Horizontal StackLayout"/>
                <HorizontalStackLayout HorizontalOptions="Center">
                    <BoxView Color="Red"
                             WidthRequest="40"
                             HeightRequest="40"/>
                    <BoxView Color="Yellow"
                             WidthRequest="40"
                             HeightRequest="40"/>
                    <BoxView Color="Blue"
                             WidthRequest="40"
                             HeightRequest="40"/>
                    <BoxView Color="Green"
                             WidthRequest="40"
                             HeightRequest="40"/>
                    <BoxView Color="Orange"
                             WidthRequest="40"
                             HeightRequest="40"/>
                    <BoxView Color="Purple"
                             WidthRequest="40"
                             HeightRequest="40"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Spacing Options -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Spacing Options"/>
                
                <Label Text="Spacing = 0"/>
                <HorizontalStackLayout Spacing="0"
                                       HorizontalOptions="Center">
                    <BoxView Color="Red" WidthRequest="30" HeightRequest="30"/>
                    <BoxView Color="Green" WidthRequest="30" HeightRequest="30"/>
                    <BoxView Color="Blue" WidthRequest="30" HeightRequest="30"/>
                </HorizontalStackLayout>
                
                <Label Text="Spacing = 10"/>
                <HorizontalStackLayout Spacing="10"
                                       HorizontalOptions="Center">
                    <BoxView Color="Red" WidthRequest="30" HeightRequest="30"/>
                    <BoxView Color="Green" WidthRequest="30" HeightRequest="30"/>
                    <BoxView Color="Blue" WidthRequest="30" HeightRequest="30"/>
                </HorizontalStackLayout>
                
                <Label Text="Spacing = 20"/>
                <HorizontalStackLayout Spacing="20"
                                       HorizontalOptions="Center">
                    <BoxView Color="Red" WidthRequest="30" HeightRequest="30"/>
                    <BoxView Color="Green" WidthRequest="30" HeightRequest="30"/>
                    <BoxView Color="Blue" WidthRequest="30" HeightRequest="30"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Vertical Options / Alignment -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="VerticalOptions Alignment"/>
                
                <Grid HeightRequest="120"
                      ColumnDefinitions="*,*,*,*"
                      BackgroundColor="LightGray">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Start"
                               VerticalOptions="Start"
                               BackgroundColor="LightBlue"
                               Padding="5"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Center"
                               VerticalOptions="Center"
                               BackgroundColor="LightGreen"
                               Padding="5"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="End"
                               VerticalOptions="End"
                               BackgroundColor="LightCoral"
                               Padding="5"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="Fill"
                               VerticalOptions="Fill"
                               BackgroundColor="LightYellow"
                               Padding="5"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- HorizontalOptions / Alignment -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="HorizontalOptions Alignment"/>
                
                <VerticalStackLayout BackgroundColor="LightGray"
                                     Padding="10"
                                     Spacing="5">
                    <BoxView Color="Red"
                             HeightRequest="30"
                             WidthRequest="100"
                             HorizontalOptions="Start"/>
                    <Label Text="Start" HorizontalOptions="Start"/>
                    
                    <BoxView Color="Green"
                             HeightRequest="30"
                             WidthRequest="100"
                             HorizontalOptions="Center"/>
                    <Label Text="Center" HorizontalOptions="Center"/>
                    
                    <BoxView Color="Blue"
                             HeightRequest="30"
                             WidthRequest="100"
                             HorizontalOptions="End"/>
                    <Label Text="End" HorizontalOptions="End"/>
                    
                    <BoxView Color="Purple"
                             HeightRequest="30"
                             HorizontalOptions="Fill"/>
                    <Label Text="Fill" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Combined StackLayout -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Combined (Nested) StackLayout"/>
                
                <VerticalStackLayout Spacing="10"
                                     BackgroundColor="LightGray"
                                     Padding="10">
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="Center">
                        <BoxView Color="Red" WidthRequest="50" HeightRequest="50"/>
                        <BoxView Color="Orange" WidthRequest="50" HeightRequest="50"/>
                        <BoxView Color="Yellow" WidthRequest="50" HeightRequest="50"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="Center">
                        <BoxView Color="Green" WidthRequest="50" HeightRequest="50"/>
                        <BoxView Color="Blue" WidthRequest="50" HeightRequest="50"/>
                        <BoxView Color="Purple" WidthRequest="50" HeightRequest="50"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- VerticalStackLayout vs HorizontalStackLayout -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="VerticalStackLayout vs HorizontalStackLayout"/>
                <Label StyleClass="h3"
                       Text="Use VerticalStackLayout and HorizontalStackLayout for better performance than StackLayout with Orientation property."/>
                
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0"
                                         BackgroundColor="LightBlue"
                                         Padding="10"
                                         Spacing="5">
                        <Label Text="VerticalStackLayout" FontAttributes="Bold"/>
                        <BoxView Color="Navy" HeightRequest="20"/>
                        <BoxView Color="Teal" HeightRequest="20"/>
                        <BoxView Color="Maroon" HeightRequest="20"/>
                    </VerticalStackLayout>
                    
                    <HorizontalStackLayout Grid.Column="1"
                                           BackgroundColor="LightGreen"
                                           Padding="10"
                                           Spacing="5">
                        <Label Text="H" FontAttributes="Bold"/>
                        <BoxView Color="Navy" WidthRequest="20"/>
                        <BoxView Color="Teal" WidthRequest="20"/>
                        <BoxView Color="Maroon" WidthRequest="20"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Margins -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Margins"/>
                <Label StyleClass="h3"
                       Text="Drag the slider to change the label&apos;s horizontal margin. The label wraps its text within the space between its margins."/>

                <Label x:Name="MarginValueLabel"
                       Text="Horizontal margin: 40"/>
                <Slider x:Name="MarginSlider"
                        Minimum="0"
                        Maximum="150"
                        Value="40"
                        ValueChanged="OnMarginSliderValueChanged"/>

                <VerticalStackLayout BackgroundColor="LightGray">
                    <Label x:Name="MarginLabel"
                           Text="The quick brown fox jumps over the lazy dog, then keeps on running far away over the hills."
                           LineBreakMode="WordWrap"
                           BackgroundColor="LightYellow"
                           Margin="40,5"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

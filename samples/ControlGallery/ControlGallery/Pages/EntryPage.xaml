<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.EntryPage"
             Title="Entry">

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2" Text="A control for entering and editing a single line of text." />

            <!-- Basic Entry -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Basic Usage" />
                <Entry Placeholder="Type something here..."/>
                <Entry Text="Pre-filled text"/>
                <Entry Placeholder="Custom placeholder text"/>
            </VerticalStackLayout>

            <!-- Password Entry -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Password Entry" />
                <Entry Placeholder="Enter password..." IsPassword="True"/>
                <Entry Text="SecretPassword123" IsPassword="True"/>
            </VerticalStackLayout>

            <!-- Constraints -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Constraints &amp; State" />
                <Label Text="Read Only:" FontSize="12" />
                <Entry Text="Read Only Content" IsReadOnly="True" />

                <Label Text="Max Length (10):" FontSize="12" />
                <Entry Placeholder="Type max 10 chars" MaxLength="10" />

                <Label Text="Disabled:" FontSize="12" />
                <Entry Text="This entry is disabled" IsEnabled="False"/>
            </VerticalStackLayout>

            <!-- Keyboard Options -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Keyboard Options" />

                <Label Text="Email:" FontSize="12" />
                <Entry Placeholder="name@example.com" Keyboard="Email" />

                <Label Text="Numeric:" FontSize="12" />
                <Entry Placeholder="123456" Keyboard="Numeric" />

                <Label Text="Telephone:" FontSize="12" />
                <Entry Placeholder="+1-555-0199" Keyboard="Telephone" />

                <Label Text="Url:" FontSize="12" />
                <Entry Placeholder="https://example.com" Keyboard="Url" />
            </VerticalStackLayout>

            <!-- Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Colors" />

                <Label Text="Text Color:" FontSize="12" />
                <Entry Text="Blue Text" TextColor="Blue"/>

                <Label Text="Placeholder Color:" FontSize="12" />
                <Entry Placeholder="Red Placeholder" PlaceholderColor="Red"/>

                <Label Text="Background Color:" FontSize="12" />
                <Entry Text="Light Yellow Background" BackgroundColor="LightGoldenrodYellow" TextColor="Black" />

                <Label Text="Light Text on a Dark Background (click the field to see the caret):" FontSize="12" />
                <Entry Text="White text" BackgroundColor="#202020" TextColor="White" />
            </VerticalStackLayout>

            <!-- Dynamic Background -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Dynamic Background" />
                <Entry x:Name="DynamicEntry" Placeholder="Background changes on button click"/>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Red" Clicked="OnRedClicked" BackgroundColor="Red" TextColor="White" />
                    <Button Text="Green" Clicked="OnGreenClicked" BackgroundColor="Green" TextColor="White" />
                    <Button Text="Blue" Clicked="OnBlueClicked" BackgroundColor="Blue" TextColor="White" />
                    <Button Text="Clear" Clicked="OnClearClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Dynamic Text Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Dynamic Text Color" />
                <Entry x:Name="DynamicTextColorEntry" Text="Text color changes on button click" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Red" Clicked="OnTextColorRedClicked" BackgroundColor="Red" TextColor="White" />
                    <Button Text="Green" Clicked="OnTextColorGreenClicked" BackgroundColor="Green" TextColor="White" />
                    <Button Text="Blue" Clicked="OnTextColorBlueClicked" BackgroundColor="Blue" TextColor="White" />
                    <Button Text="Default" Clicked="OnTextColorDefaultClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Dynamic Placeholder Color -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Dynamic Placeholder Color" />
                <Entry x:Name="DynamicPlaceholderColorEntry" Placeholder="Placeholder color changes on button click" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Red" Clicked="OnPlaceholderRedClicked" BackgroundColor="Red" TextColor="White" />
                    <Button Text="Green" Clicked="OnPlaceholderGreenClicked" BackgroundColor="Green" TextColor="White" />
                    <Button Text="Blue" Clicked="OnPlaceholderBlueClicked" BackgroundColor="Blue" TextColor="White" />
                    <Button Text="Default" Clicked="OnPlaceholderDefaultClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Typography & Formatting -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Typography &amp; Formatting" />

                <Label Text="Font Size &amp; Attributes:" FontSize="12" />
                <Entry Text="Large (24)" FontSize="24" />
                <Entry Text="Bold Italic" FontAttributes="Bold,Italic" />

                <Label Text="Character Spacing (5):" FontSize="12" />
                <Entry Text="Wide Spacing" CharacterSpacing="5" />

                <Label Text="Text Transform:" FontSize="12" />
                <Entry Text="uppercase text" TextTransform="Uppercase" />
            </VerticalStackLayout>

            <!-- Text Alignment -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Text Alignment" />

                <Label Text="Horizontal Alignment:" FontSize="12" FontAttributes="Bold"/>
                <Entry Text="Left Aligned" HorizontalTextAlignment="Start" />
                <Entry Text="Center Aligned" HorizontalTextAlignment="Center" />
                <Entry Text="Right Aligned" HorizontalTextAlignment="End" />
                <Label Text="Vertical Alignment:" FontSize="12" FontAttributes="Bold"/>
                <Entry Text="Top Aligned" VerticalTextAlignment="Start" HeightRequest="60" />
                <Entry Text="Center Aligned" VerticalTextAlignment="Center" HeightRequest="60" />
                <Entry Text="Bottom Aligned" VerticalTextAlignment="End" HeightRequest="60" />
            </VerticalStackLayout>

            <!-- Clear Button -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Clear Button" />
                <Label Text="Show 'WhileEditing':" FontSize="12" />
                <Entry Placeholder="Type to see clear button" ClearButtonVisibility="WhileEditing"/>

                <Label Text="Show 'Never' (Default):" FontSize="12" />
                <Entry Placeholder="No clear button" ClearButtonVisibility="Never"/>
            </VerticalStackLayout>

            <!-- Cursor & Selection -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Cursor &amp; Selection" />

                <Label Text="Cursor Position:" FontSize="12" FontAttributes="Bold"/>
                <Entry x:Name="CursorEntry" Text="Cursor Position Test" />
                <Label Text="{Binding CursorPosition, Source={x:Reference CursorEntry}, StringFormat='Position: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Start" Clicked="OnSetCursorStart" />
                    <Button Text="Middle" Clicked="OnSetCursorMiddle" />
                    <Button Text="End" Clicked="OnSetCursorEnd" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,5"/>

                <Label Text="Selection:" FontSize="12" FontAttributes="Bold"/>
                <Entry x:Name="SelectionEntry" Text="Select text in this entry" />
                <Label Text="{Binding SelectionLength, Source={x:Reference SelectionEntry}, StringFormat='Selection Length: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="First 5" Clicked="OnSelectFirst5" />
                    <Button Text="All" Clicked="OnSelectAll" />
                    <Button Text="Null" Clicked="OnClearSelection" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Return Key Options -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Return Key &amp; Command" />

                <Label Text="ReturnType='Done' (triggers Command):" FontSize="12" />
                <Entry Placeholder="Press Done/Enter" ReturnType="Done" ReturnCommand="{Binding ReturnCommand}" />

                <Label Text="ReturnType='Search' (triggers Command with Param):" FontSize="12" />
                <Entry Placeholder="Press Search/Enter" ReturnType="Search" ReturnCommand="{Binding ReturnCommand}" ReturnCommandParameter="SearchAction" />

                <Label Text="ReturnType='Next':" FontSize="12" />
                <Entry Placeholder="Press Next (triggers Command)" ReturnType="Next" ReturnCommand="{Binding ReturnCommand}" ReturnCommandParameter="NextAction" />

                <Label x:Name="ReturnResultLabel" Text="Command Result: Waiting..." TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </VerticalStackLayout>

            <!-- Events -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1" Text="Events" />
                <Entry x:Name="EventEntry" Placeholder="Type and press Enter..." Completed="OnEntryCompleted" TextChanged="OnEntryTextChanged"/>
                <Label x:Name="EventLabel" Text="Status: Waiting..." TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ControlGallery.Pages.AnimationBehaviorsPage"
             Title="Animation Behaviors">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Runs commands and animations from events with toolkit behaviors." />

            <!-- Event to Command -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Event to Command" />
                <Label StyleClass="h3"
                       Text="EventToCommandBehavior runs a command when an event occurs. Here the Clicked event of the button runs it." />
                <Button Text="Click Me"
                        HorizontalOptions="Start">
                    <Button.Behaviors>
                        <toolkit:EventToCommandBehavior x:Name="ClickedToCommand"
                                                        EventName="Clicked"/>
                    </Button.Behaviors>
                </Button>
                <Label x:Name="ClickCountLabel"
                       Text="Clicks: 0"/>
            </VerticalStackLayout>

            <!-- Fade Animation -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Fade Animation" />
                <Label StyleClass="h3"
                       Text="AnimationBehavior plays an animation when the view is tapped. FadeAnimation fades the view out and back in." />
                <Border x:Name="FadeBorder"
                        Padding="20"
                        HorizontalOptions="Start"
                        Stroke="{AppThemeBinding Light=#6200EE, Dark=#03DAC5}"
                        BackgroundColor="{AppThemeBinding Light=#EDE7F6, Dark=#311B92}">
                    <Border.Behaviors>
                        <toolkit:AnimationBehavior AnimateOnTap="True">
                            <toolkit:AnimationBehavior.AnimationType>
                                <toolkit:FadeAnimation Opacity="0.2"
                                                       Length="400"/>
                            </toolkit:AnimationBehavior.AnimationType>
                        </toolkit:AnimationBehavior>
                    </Border.Behaviors>
                    <Label Text="Tap me"/>
                </Border>
                <Button Text="Fade on Click"
                        HorizontalOptions="Start">
                    <Button.Behaviors>
                        <toolkit:AnimationBehavior EventName="Clicked">
                            <toolkit:AnimationBehavior.AnimationType>
                                <toolkit:FadeAnimation Opacity="0.3"/>
                            </toolkit:AnimationBehavior.AnimationType>
                        </toolkit:AnimationBehavior>
                    </Button.Behaviors>
                </Button>
            </VerticalStackLayout>

            <!-- Progress Bar Animation -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Progress Bar Animation" />
                <Label StyleClass="h3"
                       Text="ProgressBarAnimationBehavior animates the progress bar to a new value." />
                <ProgressBar>
                    <ProgressBar.Behaviors>
                        <toolkit:ProgressBarAnimationBehavior x:Name="ProgressAnimation"
                                                              Length="750"/>
                    </ProgressBar.Behaviors>
                </ProgressBar>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="0%"
                            Clicked="OnProgressZeroClicked"/>
                    <Button Text="50%"
                            Clicked="OnProgressHalfClicked"/>
                    <Button Text="100%"
                            Clicked="OnProgressFullClicked"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

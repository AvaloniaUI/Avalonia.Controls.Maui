<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             xmlns:pages="clr-namespace:ControlGallery.Pages"
             x:Class="ControlGallery.Pages.StepperPage"
             x:DataType="pages:StepperPage"
             Title="Stepper">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="The Stepper control enables users to increment or decrement a numeric value using plus and minus buttons."/>

            <!-- Basic Stepper Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic Stepper"/>
                <Label StyleClass="h3"
                       Text="Default stepper with range 0-10, increment 1"/>
                <Stepper x:Name="BasicStepper"
                         Value="{Binding BasicValue}"
                         Minimum="0"
                         Maximum="10"
                         Increment="1"
                         HorizontalOptions="Center"/>
                <Label Text="{Binding BasicValue, StringFormat='Value: {0}'}"
                       HorizontalOptions="Center"
                       FontSize="18"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Custom Increment Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Custom Increment"/>
                <Label StyleClass="h3"
                       Text="Increment by 5, range 0-100"/>
                <Stepper x:Name="CustomIncrementStepper"
                         Value="{Binding CustomIncrementValue}"
                         Minimum="0"
                         Maximum="100"
                         Increment="5"
                         HorizontalOptions="Center"/>
                <Label Text="{Binding CustomIncrementValue, StringFormat='Value: {0}'}"
                       HorizontalOptions="Center"
                       FontSize="18"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Decimal Stepper Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Decimal Stepper"/>
                <Label StyleClass="h3"
                       Text="Increment by 0.1, range 0-5"/>
                <Stepper x:Name="DecimalStepper"
                         Value="{Binding DecimalValue}"
                         Minimum="0"
                         Maximum="5"
                         Increment="0.1"
                         HorizontalOptions="Center"/>
                <Label Text="{Binding DecimalValue, StringFormat='Value: {0:F1}'}"
                       HorizontalOptions="Center"
                       FontSize="18"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Temperature Control Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Temperature"/>
                <Label StyleClass="h3"
                       Text="Thermostat-style control (15-30°C)"/>
                <Stepper x:Name="TemperatureStepper"
                         Value="{Binding Temperature}"
                         Minimum="15"
                         Maximum="30"
                         Increment="0.5"
                         HorizontalOptions="Center"/>
                <Label Text="{Binding Temperature, StringFormat='{0:F1}°C'}"
                       HorizontalOptions="Center"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{Binding TemperatureColor}"/>
                <Label Text="{Binding TemperatureDescription}"
                       HorizontalOptions="Center"
                       TextColor="Gray"/>
            </VerticalStackLayout>

            <!-- Volume Control Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Volume"/>
                <Label StyleClass="h3"
                       Text="Volume level (0-100)"/>
                <Stepper x:Name="VolumeStepper"
                         Value="{Binding Volume}"
                         Minimum="0"
                         Maximum="100"
                         Increment="10"
                         HorizontalOptions="Center"/>
                <Label Text="{Binding VolumeDisplay}"
                       HorizontalOptions="Center"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <ProgressBar Progress="{Binding VolumeProgress}"
                             ProgressColor="DarkGreen"
                             HeightRequest="10"/>
            </VerticalStackLayout>

            <!-- Styled Stepper Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Styled Stepper"/>
                <Label StyleClass="h3"
                       Text="Custom background color"/>
                <Stepper x:Name="StyledStepper"
                         Value="{Binding StyledValue}"
                         Minimum="0"
                         Maximum="50"
                         Increment="1"
                         BackgroundColor="Green"
                         HorizontalOptions="Center"/>
                <Label Text="{Binding StyledValue, StringFormat='Value: {0}'}"
                       HorizontalOptions="Center"
                       FontSize="18"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Quantity Selector Example -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Quantity Selector"/>
                <Label StyleClass="h3"
                       Text="Shopping cart item quantity (1-99)"/>
                <HorizontalStackLayout Spacing="15"
                                      HorizontalOptions="Center">
                    <Label Text="Quantity:"
                           VerticalOptions="Center"
                           FontSize="16"/>
                    <Stepper x:Name="QuantityStepper"
                             Value="{Binding Quantity}"
                             Minimum="1"
                             Maximum="99"
                             Increment="1"
                             VerticalOptions="Center"/>
                    <Label Text="{Binding Quantity, StringFormat='{0}'}"
                           VerticalOptions="Center"
                           FontSize="18"
                           FontAttributes="Bold"
                           WidthRequest="40"
                           HorizontalTextAlignment="Center"/>
                </HorizontalStackLayout>
                <Label Text="{Binding TotalPrice, StringFormat='Total: ${0:F2}'}"
                       HorizontalOptions="Center"
                       FontSize="16"
                       TextColor="Green"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Interactive Controls -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Interactive Controls"/>
                <Label StyleClass="h3"
                       Text="Control the basic stepper value with buttons"/>
                <HorizontalStackLayout Spacing="10"
                                      HorizontalOptions="Center">
                    <Button Text="Reset"
                            Command="{Binding ResetCommand}"
                            BackgroundColor="Red"
                            TextColor="White"/>
                    <Button Text="Min"
                            Command="{Binding SetMinCommand}"
                            BackgroundColor="Gray"
                            TextColor="White"/>
                    <Button Text="Mid"
                            Command="{Binding SetMidCommand}"
                            BackgroundColor="Blue"
                            TextColor="White"/>
                    <Button Text="Max"
                            Command="{Binding SetMaxCommand}"
                            BackgroundColor="Green"
                            TextColor="White"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </controls:PageLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.TooltipsPage"
             Title="Tooltips">
    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Shows a hint when the pointer hovers over a control." />

            <!-- Basic Tooltips -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Basic Tooltips" />
                <Label StyleClass="h3"
                       Text="Tooltips provide helpful hints when hovering over elements." />
                
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Button Text="Save" 
                            BackgroundColor="#3B82F6"
                            TextColor="White"
                            ToolTipProperties.Text="Save your changes" />
                    
                    <Button Text="Delete" 
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            ToolTipProperties.Text="Permanently delete this item" />
                    
                    <Button Text="Settings" 
                            BackgroundColor="#64748B"
                            TextColor="White"
                            ToolTipProperties.Text="Open application settings" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Tooltips on Various elements -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Tooltips on Various elements" />
                
                <Label Text="Hover over me!"
                       FontSize="16"
                       Padding="10"
                       BackgroundColor="#E0F2FE"
                       HorizontalOptions="Start"
                       ToolTipProperties.Text="This is a Label with a tooltip" />
                
                <Entry Placeholder="Enter your email"
                       ToolTipProperties.Text="Please enter a valid email address" />
                
                <Image Source="dotnet_bot.png"
                       WidthRequest="80"
                       HeightRequest="80"
                       HorizontalOptions="Start"
                       ToolTipProperties.Text="The .NET Bot mascot" />
                
                <BoxView Color="#10B981"
                         WidthRequest="100"
                         HeightRequest="50"
                         CornerRadius="10"
                         HorizontalOptions="Start"
                         ToolTipProperties.Text="A green BoxView element" />
            </VerticalStackLayout>

            <!-- Dynamic Tooltips -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Dynamic Tooltips" />
                <Label StyleClass="h3"
                       Text="Tooltip text can be changed at runtime." />
                
                <Button x:Name="DynamicTooltipButton"
                        Text="Hover me, then click!"
                        BackgroundColor="#8B5CF6"
                        TextColor="White"
                        Clicked="OnDynamicTooltipButtonClicked"
                        ToolTipProperties.Text="Click count: 0" />
                
                <Label x:Name="ClickCountLabel" Text="Click the button to update its tooltip." TextColor="Gray"/>
            </VerticalStackLayout>

            <!-- Slider with Tooltip -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="Slider with Value Tooltip" />
                
                <Slider x:Name="TooltipSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="50"
                        ValueChanged="OnSliderValueChanged"
                        ToolTipProperties.Text="Value: 50" />
                
                <Label x:Name="SliderValueLabel" Text="Current value: 50" TextColor="Gray" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

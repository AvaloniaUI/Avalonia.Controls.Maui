<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ControlGallery.Controls"
             x:Class="ControlGallery.Pages.BrushesPage"
             Title="Brushes">
    <ContentPage.Resources>
        <Color x:Key="AccentPrimary">#6200EE</Color>
        <Color x:Key="AccentSecondary">#03DAC5</Color>
    </ContentPage.Resources>

    <ScrollView>
        <controls:PageLayout>
            <Label StyleClass="h2"
                   Text="Solid Colors and Gradients" />

            <!-- Solid Colors -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="SolidColorBrush" />
                <Label StyleClass="h3"
                       Text="Brush.Color property" />

                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                    <Border StrokeThickness="0" HeightRequest="60" WidthRequest="60" Margin="5" BackgroundColor="Red">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Label Text="Red" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                    </Border>
                    <Border StrokeThickness="0" HeightRequest="60" WidthRequest="60" Margin="5" BackgroundColor="Green">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Label Text="Green" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                    </Border>
                     <Border StrokeThickness="0" HeightRequest="60" WidthRequest="60" Margin="5" BackgroundColor="Blue">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Label Text="Blue" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                    </Border>
                    <Border StrokeThickness="0" HeightRequest="60" WidthRequest="60" Margin="5" BackgroundColor="#80FF00FF">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Label Text="Opacity" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black" FontSize="10" FontAttributes="Bold"/>
                    </Border>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- Linear Gradients -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="LinearGradientBrush" />
                <Label StyleClass="h3"
                       Text="StartPoint and EndPoint" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" HeightRequest="100">
                    <Border StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Blue" Offset="0.1"/>
                                <GradientStop Color="Violet" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="Horizontal" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>

                    <Border Grid.Column="1" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                         <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Red" Offset="0"/>
                                <GradientStop Color="Yellow" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="Vertical" TextColor="Black" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>

                    <Border Grid.Column="2" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                         <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="Orange" Offset="0"/>
                                <GradientStop Color="Cyan" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="Diagonal" TextColor="Black" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Radial Gradients -->
            <VerticalStackLayout StyleClass="section">
                <Label StyleClass="h1"
                       Text="RadialGradientBrush" />
                <Label StyleClass="h3"
                       Text="Center and Radius" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" HeightRequest="120">
                    <Border StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                                <GradientStop Color="Blue" Offset="0"/>
                                <GradientStop Color="Pink" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Label Text="Centered" TextColor="Red" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>

                    <Border Grid.Column="1" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                         <Border.Background>
                            <RadialGradientBrush Center="0.2,0.2" Radius="0.5">
                                <GradientStop Color="Yellow" Offset="0"/>
                                <GradientStop Color="Green" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Label Text="Offset" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>
            
            <!-- Interactive Gradient -->
            <VerticalStackLayout StyleClass="section">
                 <Label StyleClass="h1"
                        Text="Animated Gradient" />
                 
                 <Border x:Name="AnimatedGradientBox" HeightRequest="150" StrokeThickness="0">
                     <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                     <Border.Background>
                         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                             <GradientStop x:Name="Stop1" Color="#FF0000" Offset="0"/>
                             <GradientStop x:Name="Stop2" Color="#0000FF" Offset="1"/>
                         </LinearGradientBrush>
                     </Border.Background>
                     <Label Text="Click Button Below" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                 </Border>
                 
                 <Button Text="Animate" Clicked="OnAnimateColorsClicked" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </controls:PageLayout>
    </ScrollView>
</ContentPage>

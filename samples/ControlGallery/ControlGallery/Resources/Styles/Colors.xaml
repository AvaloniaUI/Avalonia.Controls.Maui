<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Accent family: the Fluent theme's default system accent (#0078D7) and its light/dark steps -->
    <Color x:Key="Primary">#0078D7</Color>
    <Color x:Key="PrimaryDark">#429CE3</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#A6D8FF</Color>
    <Color x:Key="SecondaryDarkText">#76B9ED</Color>
    <Color x:Key="Tertiary">#005A9E</Color>

    <Color x:Key="CatalogAccent">#0078D7</Color>
    <Color x:Key="CatalogPageLight">#FFFFFF</Color>
    <Color x:Key="CatalogPageDark">#000000</Color>
    <Color x:Key="CatalogDrawerLight">#F2F2F2</Color>
    <Color x:Key="CatalogDrawerDark">#171717</Color>
    <Color x:Key="CatalogNavBarLight">#E6E6E6</Color>
    <Color x:Key="CatalogNavBarDark">#1F1F1F</Color>
    <Color x:Key="CatalogFooterLight">#FCFCFC</Color>
    <Color x:Key="CatalogFooterDark">#050505</Color>
    <Color x:Key="CatalogBaseHighLight">#FF000000</Color>
    <Color x:Key="CatalogBaseHighDark">#FFFFFFFF</Color>
    <Color x:Key="CatalogBaseMediumLight">#99000000</Color>
    <Color x:Key="CatalogBaseMediumDark">#99FFFFFF</Color>
    <Color x:Key="CatalogBaseLowLight">#33000000</Color>
    <Color x:Key="CatalogBaseLowDark">#33FFFFFF</Color>
    <SolidColorBrush x:Key="CatalogHoverStrokeLight" Color="#14000000" />
    <SolidColorBrush x:Key="CatalogHoverStrokeDark" Color="#2FFFFFFF" />

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    
    <Color x:Key="BannerLight">#f3f1ef</Color>
    <Color x:Key="BannerDark">#111222</Color>

    <Color x:Key="SectionBorderLight">#CCCCCC</Color>
    <Color x:Key="SectionBorderDark">#444444</Color>
    <Color x:Key="SectionBackgroundLight">#FFFFFF</Color>
    <Color x:Key="SectionBackgroundDark">#1E1E1E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
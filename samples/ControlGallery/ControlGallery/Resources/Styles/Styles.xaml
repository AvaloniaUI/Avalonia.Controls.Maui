<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CatalogPageLight}, Dark={StaticResource CatalogPageDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource CatalogNavBarLight}, Dark={StaticResource CatalogNavBarDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseHighLight}, Dark={StaticResource CatalogBaseHighDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseHighLight}, Dark={StaticResource CatalogBaseHighDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseLowLight}, Dark={StaticResource CatalogBaseLowDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseMediumLight}, Dark={StaticResource CatalogBaseMediumDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource CatalogPageLight}, Dark={StaticResource CatalogPageDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource CatalogAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseHighLight}, Dark={StaticResource CatalogBaseHighDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseMediumLight}, Dark={StaticResource CatalogBaseMediumDark}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource CatalogNavBarLight}, Dark={StaticResource CatalogNavBarDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseHighLight}, Dark={StaticResource CatalogBaseHighDark}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseHighLight}, Dark={StaticResource CatalogBaseHighDark}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource CatalogPageLight}, Dark={StaticResource CatalogPageDark}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseHighLight}, Dark={StaticResource CatalogBaseHighDark}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource CatalogBaseMediumLight}, Dark={StaticResource CatalogBaseMediumDark}}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource CatalogAccent}" />
    </Style>

    <Style TargetType="Label" Class="h1">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style TargetType="Label" Class="h2">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="MaximumWidthRequest" Value="400" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style TargetType="Label" Class="h3">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- One titled group of samples on a page, under an h1 -->
    <Style TargetType="VerticalStackLayout" Class="section">
        <Setter Property="Spacing" Value="8" />
    </Style>

</ResourceDictionary>
